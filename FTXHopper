local blockedNames = {

	["SECRET"] = true,
	["GOLD"] = true,
	["DIAMOND"] = true,
	["RADIOACTIVE"] = true,

	["STOLEN"] = true,
	["STEAL"] = true,

	["COMMON"] = true,
	["RARE"] = true,
	["EPIC"] = true,
	["LEGENDARY"] = true,
	["MYTHIC"] = true,

	["COLLECT"] = true,
	["OFFLINE CASH"] = true
}

local function findBrainrotName(label)

	local gui =
		label:
			FindFirstAncestorWhichIsA(
				"BillboardGui"
			)
		or
		label:
			FindFirstAncestorWhichIsA(
				"SurfaceGui"
			)

	if not gui then
		return "UNKNOWN"
	end

	for _, object in ipairs(
		gui:GetDescendants()
	) do

		if
			object ~= label
			and (
				object:IsA(
					"TextLabel"
				)
				or
				object:IsA(
					"TextButton"
				)
			)
		then

			local text =
				tostring(
					object.Text
					or ""
				)

			local upper =
				text:upper()

			if
				#text >= 2
				and #text <= 60
				and not parseMoney(text)
				and not blockedNames[upper]
			then

				return text
			end
		end
	end

	return "UNKNOWN"
end

