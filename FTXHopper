local function addScale(
	object,
	name,
	value
)

	local old = object:FindFirstChild(
		name
	)

	if old then
		old:Destroy()
	end

	local s = Instance.new("UIScale")

	s.Name = name
	s.Scale = value
	s.Parent = object

	return s

end


