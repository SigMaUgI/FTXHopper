-- SERVER HOPPER
--========================================================

local hopping = false

local failedServers = {}

local function getHTTP(url)

	local req =
		getRequestFunction()

	if type(req) == "function" then

		local success,
			response =
			pcall(function()

				return req({
					Url = url,
					Method = "GET"
				})
			end)

		if
			success
			and response
			and response.Body
		then

			return response.Body
		end
	end

	local success,
		body =
		pcall(function()

			return game:HttpGet(url)
		end)

	if success then
		return body
	end
end

local function getServerCandidates()

	local url =
		"https://games.roblox.com/v1/games/"
		.. tostring(
			TARGET_PLACE_ID
		)
		.. "/servers/Public?sortOrder=Asc&limit=100"

	local body =
		getHTTP(url)

	if not body then
		return {}
	end

	local success,
		data =
		pcall(function()

			return
				HttpService:
					JSONDecode(
						body
					)
		end)

	if
		not success
		or not data
		or type(data.data) ~= "table"
	then
		return {}
	end

	local servers = {}

	for _, server in ipairs(
		data.data
	) do

		local id =
			server.id

		local playing =
			tonumber(
				server.playing
			)

		local maximum =
			tonumber(
				server.maxPlayers
			)

		if
			id
			and id ~= game.JobId
			and not failedServers[id]
			and playing
			and maximum
			and playing < maximum
		then

			table.insert(
				servers,
				server
			)
		end
	end

	return servers
end

local function resetHopButton()

	HopButton.Text = "HOP"
	HopButton.TextSize = 24
end

local function serverHop()

	if hopping then
		return
	end

	hopping = true

	HopButton.Text =
		"FINDING..."

	HopButton.TextSize = 14

	task.spawn(function()

		for _ = 1, 6 do

			if not hopping then
				return
			end

			local servers =
				getServerCandidates()

			if #servers > 0 then

				local server =
					servers[
						RNG:
							NextInteger(
								1,
								#servers
							)
					]

				if
					server
					and server.id
					and server.id ~= game.JobId
				then

					HopButton.Text =
						"HOPPING..."

					local success =
						pcall(function()

							TeleportService:
								TeleportToPlaceInstance(
									TARGET_PLACE_ID,
									server.id,
									LP
								)
						end)

					if success then
						return
					end

					failedServers[
						server.id
					] = true
				end

			else

				-- Old fallback behavior

				HopButton.Text =
					"RANDOM..."

				pcall(function()

					TeleportService:
						Teleport(
							TARGET_PLACE_ID,
							LP
						)
				end)
			end

			task.wait(0.15)
		end

		hopping = false

		resetHopButton()

	end)
end

pcall(function()

