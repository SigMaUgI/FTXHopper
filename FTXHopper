-- BRAINROT NAME
--========================================================

local blockedNameWords = {

	"SECRET",
	"GOLD",
	"RADIOACTIVE",
	"CANDY",
	"DIAMOND",
	"CYBER",
	"STOLEN",
	"COLLECT",
	"COMMON",
	"RARE",
	"EPIC",
	"LEGENDARY",
	"MYTHIC",
	"STEAL",
	"OFFLINE CASH"

}


local function badName(text)

	if
		not text
		or text == ""
	then

		return true

	end


	if parseMoney(text) then
		return true
	end


	local upper =
		text:upper()


	for _, word in ipairs(
		blockedNameWords
	) do

		if
			upper == word

			or upper:find(
				word,
				1,
				true
			)
		then

			return true

		end

	end


	return false

end


local function findBrainrotName(label)

	local gui =
		label:
			FindFirstAncestorWhichIsA(
				"BillboardGui"
			)

		or label:
			FindFirstAncestorWhichIsA(
				"SurfaceGui"
			)

		or label.Parent


	if not gui then
		return "UNKNOWN"
	end


	local best = nil
	local bestScore = -math.huge


	for _, object in ipairs(
		gui:GetDescendants()
	) do

		if
			object ~= label

			and (
				object:IsA(
					"TextLabel"
				)

				or object:IsA(
					"TextButton"
				)
			)
		then

			local text =
				tostring(
					object.Text
					or ""
				)


			if
				#text >= 2
				and #text <= 70
				and not badName(
					text
				)
			then

				local score = 0

				if
					object.Parent
					== label.Parent
				then

					score += 1000

				end


				if
					object.AbsolutePosition.Y
					< label.AbsolutePosition.Y
				then

					score += 500

				end


				if score > bestScore then

					bestScore =
						score

					best =
						text

				end

			end

		end

	end


	return best or "UNKNOWN"

end


