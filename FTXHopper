local function hasGoodBrainrot()

	for label, data in pairs(
		MoneyTargets
	) do

		if
			label
			and label.Parent
			and data
			and data.Value
			and data.Value >= MIN_MONEY
			and data.Part
			and data.Part.Parent
		then

			return true, data, label
		end
	end

	return false, nil, nil
end

local function removeESP(label)

	local data =
		BrainrotESP[label]

	if data then

		if data.Gui then
			data.Gui:Destroy()
		end

		if data.Beam then
			data.Beam:Destroy()
		end

		if data.Attachment then
			data.Attachment:Destroy()
		end
	end

	BrainrotESP[label] = nil
end

