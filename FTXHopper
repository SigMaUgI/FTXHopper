local PlayerESP = {}

local function setupPlayer(player)

	if player == LP then
		return
	end

	if PlayerESP[player] then
		return
	end

	PlayerESP[player] = {}

	local data =
		PlayerESP[player]

	local function characterAdded(character)

		if data.Highlight then
			data.Highlight:Destroy()
		end

		if data.Billboard then
			data.Billboard:Destroy()
		end

		local head =
			character:WaitForChild(
				"Head",
				5
			)

		if not head then
			return
		end

		local billboard =
			Instance.new(
				"BillboardGui"
			)

		billboard.Adornee =
			head

		billboard.AlwaysOnTop = true
		billboard.MaxDistance = 100000

		billboard.Size =
			UDim2.new(
				0,
				300,
				0,
				65
			)

		billboard.StudsOffset =
			Vector3.new(
				0,
				3.5,
				0
			)

		billboard.Parent =
			Gui

		local name =
			Instance.new(
				"TextLabel"
			)

		name.Size =
			UDim2.fromScale(
				1,
				1
			)

		name.BackgroundTransparency = 1

		name.Text =
			player.Name

		name.TextColor3 =
			Color3.new(
				1,
				1,
				1
			)

		name.TextStrokeTransparency = 0.1

		name.Font =
			Enum.Font.GothamBlack

		name.TextScaled = true
		name.Parent = billboard

		local highlight =
			Instance.new(
				"Highlight"
			)

		highlight.Adornee =
			character

		highlight.DepthMode =
			Enum.HighlightDepthMode.AlwaysOnTop

		highlight.FillTransparency = 0.2
		highlight.OutlineTransparency = 0
		highlight.Enabled = false

		highlight.Parent =
			character

		data.Billboard = billboard
		data.Label = name
		data.Highlight = highlight
	end

	if player.Character then

		task.spawn(
			characterAdded,
			player.Character
		)
	end

	player.CharacterAdded:
		Connect(
			characterAdded
		)
end

for _, player in ipairs(
	Players:GetPlayers()
) do

	setupPlayer(player)
end

Players.PlayerAdded:
	Connect(
		setupPlayer
	)

Players.PlayerRemoving:
	Connect(function(player)

		local data =
			PlayerESP[player]

		if data then

			if data.Highlight then
				data.Highlight:Destroy()
			end

			if data.Billboard then
				data.Billboard:Destroy()
			end
		end

		PlayerESP[player] = nil
	end)

--========================================================
-- RADAR UPDATE
--========================================================

local lastRadar = 0

RunService.Heartbeat:
	Connect(function()

		local root =
			getRoot()

		if not root then
			return
		end

		if radarCircleEnabled then

			RadarCircle.Transparency = 0.7

			RadarCircle.CFrame =
				CFrame.new(
					root.Position.X,
					root.Position.Y - 2.7,
					root.Position.Z
				)
				*
				CFrame.Angles(
					0,
					0,
					math.rad(90)
				)

		else

			RadarCircle.Transparency = 1
		end

		local nearby = {}

		for player, data in pairs(
			PlayerESP
		) do

			local other =
				player.Character
				and
				player.Character:
					FindFirstChild(
						"HumanoidRootPart"
					)

			if
				other
				and data.Highlight
				and data.Label
			then

				local distance =
					(
						other.Position
						- root.Position
					).Magnitude

				if not playerHighlightEnabled then

					data.Highlight.Enabled = false

				elseif distance <= RED_RANGE then

					data.Highlight.Enabled = true

					data.Highlight.FillColor =
						Color3.fromRGB(
							255,
							30,
							30
						)

					data.Highlight.OutlineColor =
						Color3.fromRGB(
							255,
							0,
							0
						)

					data.Label.TextColor3 =
						Color3.fromRGB(
							255,
							70,
							70
						)

				elseif distance <= GREEN_RANGE then

					data.Highlight.Enabled = true

					data.Highlight.FillColor =
						Color3.fromRGB(
							40,
							255,
							70
						)

					data.Highlight.OutlineColor =
						Color3.fromRGB(
							20,
							255,
							40
						)

					data.Label.TextColor3 =
						Color3.fromRGB(
							70,
							255,
							95
						)

				else

					data.Highlight.Enabled = false

					data.Label.TextColor3 =
						Color3.new(
							1,
							1,
							1
						)
				end

				if distance <= GREEN_RANGE then

					table.insert(
						nearby,
						{
							Player = player,
							Distance = distance
						}
					)
				end
			end
		end

		if
			os.clock() - lastRadar
			< RADAR_RATE
		then
			return
		end

		lastRadar =
			os.clock()

		for _, object in ipairs(
			RadarList:GetChildren()
		) do

			if object:IsA(
				"TextLabel"
			) then
				object:Destroy()
			end
		end

		table.sort(
			nearby,
			function(a, b)

				return
					a.Distance
					< b.Distance
			end
		)

		for _, info in ipairs(
			nearby
		) do

			local row =
				Instance.new(
					"TextLabel"
				)

			row.Size =
				UDim2.new(
					1,
					-4,
					0,
					36
				)

			row.BackgroundColor3 =
				Color3.fromRGB(
					23,
					23,
					28
				)

			row.BorderSizePixel = 0

			row.Text =
				info.Player.Name
				.. " • "
				.. string.format(
					"%.1f studs",
					info.Distance
				)

			row.TextColor3 =
				info.Distance <= RED_RANGE
				and
				Color3.fromRGB(
					255,
					70,
					70
				)
				or
				Color3.fromRGB(
					80,
					255,
					100
				)

			row.Font =
				Enum.Font.GothamBold

			row.TextSize = 12
			row.Parent = RadarList

			corner(
				row,
				8
			)
		end
	end)

