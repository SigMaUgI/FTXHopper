local kickTriggered =
	false


local WatchedUI =
	{}


local function checkYouStole(
	text
)

	if
		not autoKickEnabled
		or kickTriggered
	then

		return

	end


	if
		typeof(text)
		~= "string"
	then

		return

	end


	if
		text:
			lower():
			find(
				"you stole",
				1,
				true
			)
	then

		kickTriggered =
			true


		LP:Kick(
			"You stole"
		)

	end

end


local function watchUI(
	object
)

	if WatchedUI[
		object
	] then

		return

	end


	if
		not object:IsA(
			"TextLabel"
		)

		and not object:IsA(
			"TextButton"
		)
	then

		return

	end


	WatchedUI[
		object
	] =
		true


	checkYouStole(
		object.Text
	)


	object:
		GetPropertyChangedSignal(
			"Text"
		):
		Connect(function()

			checkYouStole(
				object.Text
			)

		end)

end


for _, object in ipairs(
	PlayerGui:
		GetDescendants()
) do

	watchUI(
		object
	)

end


