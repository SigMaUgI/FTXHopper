--========================================================
-- PROMPT POSITION
--========================================================

local function promptPosition(
	prompt
)

	if
		not prompt
		or not prompt.Parent
	then

		return nil

	end


	local parent =
		prompt.Parent


	if
		parent:IsA(
			"Attachment"
		)
	then

		return
			parent.WorldPosition

	end


	if
		parent:IsA(
			"BasePart"
		)
	then

		return
			parent.Position

	end


	local model =
		parent:
			FindFirstAncestorWhichIsA(
				"Model"
			)


	if model then

		local part =
			model.PrimaryPart

			or model:
				FindFirstChildWhichIsA(
					"BasePart",
					true
				)


		if part then

			return
				part.Position

		end

	end


	return nil

end


local function promptPart(
	prompt
)

	if
		not prompt
		or not prompt.Parent
	then

		return nil

	end


	if
		prompt.Parent:IsA(
			"Attachment"
		)

		and prompt.Parent.Parent

		and prompt.Parent.Parent:
			IsA(
				"BasePart"
			)
	then

		return
			prompt.Parent.Parent

	end


	if
		prompt.Parent:IsA(
			"BasePart"
		)
	then

		return
			prompt.Parent

	end


	local model =
		prompt.Parent:
			FindFirstAncestorWhichIsA(
				"Model"
			)


	if model then

		return
			model.PrimaryPart

			or model:
				FindFirstChildWhichIsA(
					"BasePart",
					true
				)

	end


	return nil

end


--========================================================
-- PROMPT RANGE
--========================================================

local function promptInRange(
	prompt
)

	if
		not isStealPrompt(
			prompt
		)
	then

		return false

	end


	local root =
		getRoot()


	local pos =
		promptPosition(
			prompt
		)


	if
		not root
		or not pos
	then

		return false

	end


	local maxDistance =
		tonumber(
			prompt.MaxActivationDistance
		)
		or 10


	return
		(
			root.Position
			- pos
		).Magnitude

		<= maxDistance
			+ 0.75

end


local function promptUsable(
	prompt
)

	if
		not promptInRange(
			prompt
		)
	then

		return false

	end


	if PromptBlocked[
		prompt
	] then

		return false

	end


	if
		VisiblePrompts[
			prompt
		]
		== false
	then

		return false

	end


	return true

end


--========================================================
-- PHYSICAL PROMPT DISTANCE
--========================================================

local function promptPhysicalDistance(
	prompt
)

	local root =
		getRoot()


	if not root then

		return
			math.huge

	end


	local part =
		promptPart(
			prompt
		)


	if part then

		return
			closestPointDistance(
				root.Position,
				part
			)

	end


	local pos =
		promptPosition(
			prompt
		)


	if not pos then

		return
			math.huge

	end


	return
		horizontalDistance(
			root.Position,
			pos
		)

end


--========================================================
-- NEAREST STEAL
--========================================================

local function getNearestSteal()

	local best =
		nil


	local bestDistance =
		math.huge


	for prompt in pairs(
		Prompts
	) do

		if
			promptUsable(
				prompt
			)
		then

			local distance =
				promptPhysicalDistance(
					prompt
				)


			if
				distance
				< bestDistance
			then

				best =
					prompt


				bestDistance =
					distance

			end

		end

	end


	return
		best,
		bestDistance

end


--========================================================
-- PROMPT MONEY
--========================================================

local function promptMoney(
	prompt
)

	local position =
		promptPosition(
			prompt
		)


	if not position then
		return nil
	end


	local best =
		nil


	local bestDistance =
		math.huge


	for _, data in pairs(
		MoneyTargets
	) do

		if
			data.Part
			and data.Part.Parent
		then

			local distance =
				horizontalDistance(
					position,
					data.Part.Position
				)


			if
				distance < bestDistance
				and distance <= 25
			then

				bestDistance =
					distance


				best =
					data.Value

			end

		end

	end


	return
		best

end


