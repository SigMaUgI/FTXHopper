RunService.Heartbeat:
	Connect(function()

		local root =
			getRoot()


		if not root then
			return
		end


		--============================================
		-- CIRCLE TOGGLE
		--============================================

		if radarCircleEnabled then

			RadarCircle.Transparency =
				0.7


			RadarCircle.CFrame =
				CFrame.new(

					root.Position.X,

					root.Position.Y
						- 2.7,

					root.Position.Z

				)

				* CFrame.Angles(
					0,
					0,
					math.rad(
						90
					)
				)

		else

			RadarCircle.Transparency =
				1

		end


		local nearby = {}


		for player, data in pairs(
			PlayerESP
		) do

			local otherRoot =
				player.Character

				and player.Character:
					FindFirstChild(
						"HumanoidRootPart"
					)


			if
				otherRoot
				and data.Highlight
			then

				local distance =
					(
						otherRoot.Position
						- root.Position
					).Magnitude


				data.Distance =
					distance


				--====================================
				-- PLAYER HIGHLIGHT TOGGLE
				--====================================

				if not playerHighlightEnabled then

					data.Highlight.Enabled =
						false

					if data.Name then

						data.Name.TextColor3 =
							Color3.new(
								1,
								1,
								1
							)

					end


				elseif distance <= RED_RANGE then

					data.Highlight.Enabled =
						true

					data.Highlight.FillColor =
						Color3.fromRGB(
							255,
							25,
							25
						)

					data.Highlight.OutlineColor =
						Color3.fromRGB(
							255,
							0,
							0
						)

					data.Name.TextColor3 =
						Color3.fromRGB(
							255,
							55,
							55
						)


				elseif distance <= GREEN_RANGE then

					data.Highlight.Enabled =
						true

					data.Highlight.FillColor =
						Color3.fromRGB(
							40,
							255,
							70
						)

					data.Highlight.OutlineColor =
						Color3.fromRGB(
							20,
							255,
							45
						)

					data.Name.TextColor3 =
						Color3.fromRGB(
							70,
							255,
							95
						)


