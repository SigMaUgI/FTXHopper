		else

			RadarCircle.Transparency =
				1

		end


		local nearby =
			{}


		for player, data in pairs(
			PlayerESP
		) do

			local otherRoot =
				player.Character

				and player.Character:
					FindFirstChild(
						"HumanoidRootPart"
