						)
					)

				BaseBeam.Parent =
					WorldFolder

			end

		end

		if BaseBeam then

			local rootAttachment =
				getRootAttachment()

			if rootAttachment then

				BaseBeam.Attachment0 =
					rootAttachment

			end

		end

		task.wait(1)

	end

end)

