local function checkMoney(obj)

	if
		not obj
		or not obj.Parent
	then
		return
	end

	local value =
		parseMoney(
			obj.Text
		)

	if not value then

		MoneyTargets[obj] =
			nil

		announced[obj] =
			nil

		removeESP(obj)

		return

	end

	local part =
		getWorldPart(obj)

	if not part then
		return
	end

	local data = {

		Value = value,
		Part = part,

		Name =
			findBrainrotName(obj),

		Text =
			tostring(
				obj.Text
			)

	}

	MoneyTargets[obj] =
		data

	if value >= MIN_MONEY then

		if not announced[obj] then

			announced[obj] =
				true

			playGoodSound()

		end

		if not BrainrotESP[obj] then

			createESP(
				obj,
				data
			)

		else

			BrainrotESP[obj].Label.Text =
				data.Name
				.. "\n"
				.. data.Text

		end

		-- AUTO HOP STOPS THE MOMENT $20M+ EXISTS.
		stopAutoHop()

	else

		announced[obj] =
			nil

		removeESP(obj)

	end

end

local function watchMoney(obj)

	if WatchedMoney[obj] then
		return
	end

	if
		not obj:IsA(
			"TextLabel"
		)
		and not obj:IsA(
			"TextButton"
		)
	then

		return

	end

	WatchedMoney[obj] =
		true

	checkMoney(obj)

	obj:
		GetPropertyChangedSignal(
			"Text"
		):
		Connect(function()

			checkMoney(obj)

		end)

end

local function scanMoney()

	for index, obj in ipairs(
		workspace:GetDescendants()
	) do

		if
			obj:IsA(
				"TextLabel"
			)
			or obj:IsA(
				"TextButton"
			)
		then

			watchMoney(obj)
			checkMoney(obj)

		end

		if
			index % 600 == 0
		then

			task.wait()

		end

	end

end

