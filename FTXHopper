				end

			end

		end


		if
			os.clock()
			- lastRadarUpdate
			< RADAR_LIST_RATE
		then

			return

		end


		lastRadarUpdate =
			os.clock()


		for _, object in ipairs(
			RadarList:GetChildren()
		) do

			if object:IsA(
				"Frame"
			) then

				object:Destroy()

			end

		end


		table.sort(
			nearby,

			function(a, b)

				return
					a.Distance
					< b.Distance

			end
		)


		for _, info in ipairs(
			nearby
		) do

