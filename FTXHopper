local function isStealPrompt(prompt)

	if
		not prompt
		or not prompt.Parent
		or not prompt.Enabled
	then

		return false

	end

	local action =
		tostring(
			prompt.ActionText or ""
		):
		lower()

	local objectText =
		tostring(
			prompt.ObjectText or ""
		):
		lower()

	return
		action:find(
			"steal",
			1,
			true
		)
		or objectText:find(
			"steal",
			1,
			true
		)

end

local function promptPosition(prompt)

	if
		not prompt
		or not prompt.Parent
	then

		return nil

	end

	if prompt.Parent:IsA("Attachment") then
		return prompt.Parent.WorldPosition
	end

	if prompt.Parent:IsA("BasePart") then
		return prompt.Parent.Position
	end

	local model =
		prompt.Parent:
			FindFirstAncestorWhichIsA(
				"Model"
			)

	if model then

		local part =
			model.PrimaryPart
			or model:
				FindFirstChildWhichIsA(
					"BasePart",
					true
				)

		if part then
			return part.Position
		end

	end

end

local function promptDistance(prompt)

	local root = getRoot()
	local pos = promptPosition(prompt)

	if not root or not pos then
		return math.huge
	end

	return
		(
			root.Position
			- pos
		).Magnitude

end

local function getNearestPrompt()

	local best
	local bestDistance =
		math.huge

	for prompt in pairs(Prompts) do

		if isStealPrompt(prompt) then

			local distance =
				promptDistance(prompt)

			if
				distance
				<= (
					prompt.MaxActivationDistance
					+ 0.75
				)
				and distance < bestDistance
			then

				best = prompt
				bestDistance = distance

			end

		end

	end

	return best

end

local function getPromptMoney(prompt)

	local pos =
		promptPosition(prompt)

	if not pos then
		return nil
	end

	local nearest =
		math.huge

	local money

	for _, data in pairs(
		MoneyTargets
	) do

		if
			data.Part
			and data.Part.Parent
		then

			local distance =
				(
					data.Part.Position
					- pos
				).Magnitude

			if
				distance < nearest
				and distance <= 25
			then

				nearest = distance
				money = data.Value

			end

		end

	end

	return money

end

local function getHighestPrompt()

	local best
	local bestMoney = -math.huge

	for prompt in pairs(Prompts) do

		if isStealPrompt(prompt) then

			local distance =
				promptDistance(prompt)

			if
				distance
				<= (
					prompt.MaxActivationDistance
					+ 0.75
				)
			then

				local money =
					getPromptMoney(prompt)

				if
					money
					and money > bestMoney
				then

					bestMoney = money
					best = prompt

				end

			end

		end

	end

	return best

end

local stealing = false

local function holdPrompt(prompt)

	if
		stealing
		or not prompt
		or not prompt.Parent
	then

		return

	end

	stealing = true

	pcall(function()

		prompt:InputHoldBegin()

		local hold =
			math.max(
				prompt.HoldDuration,
				0.05
			)

		task.wait(hold + 0.05)

		prompt:InputHoldEnd()

	end)

	stealing = false

end

task.spawn(function()

	while Gui.Parent do

		if not stealing then

			if nearestEnabled then

				local prompt =
					getNearestPrompt()

				if prompt then

					task.spawn(
						holdPrompt,
						prompt
					)

				end

			elseif highestEnabled then

				local prompt =
					getHighestPrompt()

				if prompt then

					task.spawn(
						holdPrompt,
						prompt
					)

				end

			end

		end

		task.wait(0.04)

	end

end)

