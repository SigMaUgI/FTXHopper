--========================================================

local stealing =
	false


local currentPrompt =
	nil


local stealGeneration =
	0


-- NEW watchdog timestamps.
local progressShownAt =
	0


local lastRealHoldHeartbeat =
	0


local forceReacquire =
	false


local function showProgress()

	if not Progress.Visible then

		progressShownAt =
			os.clock()

	end


	Progress.Visible =
		true

end


local function hideProgress()

