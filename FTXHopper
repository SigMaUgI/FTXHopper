--========================================================
-- MONEY
--========================================================

local function parseMoney(
	text
)

	if typeof(text) ~= "string" then
		return nil
	end


	local clean =
		text:
			upper():
			gsub(",", ""):
			gsub("^%s+", ""):
			gsub("%s+$", "")


	local number,
		suffix =
		clean:
			match(
				"^%$([%d%.]+)([KMBTQ]?)%s*/%s*S$"
			)


	if not number then

		number,
			suffix =
			clean:
				match(
					"^%$([%d%.]+)([KMBTQ]?)%s*/%s*SEC$"
				)

	end


	if not number then

		number,
			suffix =
			clean:
				match(
					"^%$([%d%.]+)([KMBTQ]?)%s*PER%s*SEC$"
				)

	end


	number =
		tonumber(
			number
		)


	if not number then
		return nil
	end


	local mult =
		1


	if suffix == "K" then
		mult = 1e3

	elseif suffix == "M" then
		mult = 1e6

	elseif suffix == "B" then
		mult = 1e9

	elseif suffix == "T" then
		mult = 1e12

	elseif suffix == "Q" then
		mult = 1e15
	end


	return
		number
		* mult

end


local function formatMoney(
	value
)

	if not value then
		return "$0/s"
	end


	if value >= 1e15 then

		return string.format(
			"$%.2fQ/s",
			value / 1e15
		)

	elseif value >= 1e12 then

		return string.format(
			"$%.2fT/s",
			value / 1e12
		)

	elseif value >= 1e9 then

		return string.format(
			"$%.2fB/s",
			value / 1e9
		)

	elseif value >= 1e6 then

		return string.format(
			"$%.2fM/s",
			value / 1e6
		)

	end


	return
		"$"
		.. tostring(
			math.floor(
				value
			)
		)
		.. "/s"

end


--========================================================
-- WORLD PART
--========================================================

local function getWorldPart(
	object
)

	local current =
		object


	for _ = 1, 24 do

		if not current then
			break
		end


		if
			current:IsA(
				"BillboardGui"
			)

			or current:IsA(
				"SurfaceGui"
			)
		then

			local adornee =
				current.Adornee


			if adornee then

				if
					adornee:IsA(
						"BasePart"
					)
				then

					return
						adornee

				end


				if
					adornee:IsA(
						"Attachment"
					)

					and adornee.Parent

					and adornee.Parent:
						IsA(
							"BasePart"
						)
				then

					return
						adornee.Parent

				end

			end

		end


		if current:IsA(
			"BasePart"
		) then

			return current

		end


		if current:IsA(
			"Model"
		) then

			return
				current.PrimaryPart

				or current:
					FindFirstChildWhichIsA(
						"BasePart",
						true
					)

		end


		current =
			current.Parent

	end


	return nil

end


--========================================================
-- BRAINROT NAME
--========================================================

local blockedWords = {

	"SECRET",
	"GOLD",
	"RADIOACTIVE",
	"CANDY",
	"DIAMOND",
	"CYBER",
	"STOLEN",
	"COLLECT",
	"COMMON",
	"RARE",
	"EPIC",
	"LEGENDARY",
	"MYTHIC",
	"STEAL",
	"OFFLINE CASH"

}


local function badBrainrotName(
	text
)

	if
		not text
		or text == ""
	then

		return true

	end


	if parseMoney(text) then
		return true
	end


	local upper =
		text:
			upper()


	for _, word in ipairs(
		blockedWords
	) do

		if
			upper == word

			or upper:
				find(
					word,
					1,
					true
				)
		then

			return true

		end

	end


	return false

end


local function findBrainrotName(
	label
)

	local gui =
		label:
			FindFirstAncestorWhichIsA(
				"BillboardGui"
			)

		or label:
			FindFirstAncestorWhichIsA(
				"SurfaceGui"
			)

		or label.Parent


	if not gui then
		return "UNKNOWN"
	end


	local best =
		nil


	local bestScore =
		-math.huge


	for _, object in ipairs(
		gui:
			GetDescendants()
	) do

		if
			object ~= label

			and (
				object:IsA(
					"TextLabel"
				)

				or object:IsA(
					"TextButton"
				)
			)
		then

			local text =
				tostring(
					object.Text
					or ""
				)


			if
				#text >= 2

				and #text <= 70

				and not badBrainrotName(
					text
				)
			then

				local score =
					0


				if
					object.Parent
					== label.Parent
				then

					score +=
						1000

				end


				if
					object.AbsolutePosition.Y
					< label.AbsolutePosition.Y
				then

					score +=
						500

				end


				if score > bestScore then

					bestScore =
						score

					best =
						text

				end

			end

		end

	end


	return
		best
		or "UNKNOWN"

end


