	)


--========================================================
-- SERVER HOP
--========================================================

local hopping =
	false


local visitedServers =
	{}


local failedServers =
	{}


local function httpGet(
	url
)

	local ok,
		result =
		pcall(function()

			return
				game:
					HttpGet(
						url
					)

		end)


	if
		ok
		and result
	then

		return
			result

	end


	local req =
		request
		or http_request
		or (
			syn
			and syn.request
		)


	if
		type(req)
		== "function"
	then

		local success,
			response =
			pcall(function()

				return req({

					Url =
						url,

					Method =
						"GET"

				})

			end)


		if
			success
			and response
			and response.Body
		then

			return
				response.Body

		end

	end


	return nil

end


local function getServers()

	local candidates =
		{}


	local seen =
		{}


	for _, order in ipairs({
		"Asc",
		"Desc"
	}) do

		local cursor =
			nil


		for _ = 1, 6 do

			local url =
				"https://games.roblox.com/v1/games/"
				.. tostring(
					TARGET_PLACE_ID
				)
				.. "/servers/Public?sortOrder="
				.. order
				.. "&limit=100"


			if cursor then

				url ..=
					"&cursor="
					.. HttpService:
						UrlEncode(
							cursor
						)

			end


			local body =
				httpGet(
					url
				)


			if not body then
				break
			end


			local decodeOK,
				data =
				pcall(function()

					return
						HttpService:
							JSONDecode(
								body
							)

				end)


			if
				not decodeOK
				or not data
			then

				break

			end


			for _, server in ipairs(
				data.data
				or {}
			) do

				local id =
					server.id


				local playing =
					tonumber(
						server.playing
					)


				local maxPlayers =
					tonumber(
						server.maxPlayers
					)


				if
					id

					and id
						~= game.JobId

					and not seen[
						id
					]

					and not visitedServers[
						id
					]

					and not failedServers[
						id
					]

					and playing

					and maxPlayers

					and playing
						< maxPlayers
				then

					seen[
						id
					] =
						true


					table.insert(
						candidates,
						server
					)

				end

			end


			cursor =
				data.nextPageCursor


			if
				not cursor
				or #candidates
					>= 120
			then

				break

			end

		end

	end


	return
		candidates

end


local function serverHop()

	if hopping then
		return
	end


	hopping =
		true


	HopButton.Text =
		"FINDING..."


	HopButton.TextSize =
		14


	task.spawn(function()

		for _ = 1, 15 do

			local servers =
				getServers()


			if #servers == 0 then

				visitedServers =
					{}


				task.wait(
					0.1
				)


				continue

			end


			local server =
				servers[
					RNG:
						NextInteger(
							1,
							#servers
						)
				]


			visitedServers[
				server.id
			] =
				true


			HopButton.Text =
				"HOPPING..."


			local success =
				pcall(function()

					TeleportService:
						TeleportToPlaceInstance(

							TARGET_PLACE_ID,

							server.id,

							LP

						)

				end)


			if success then

				task.wait(
					TELEPORT_TIMEOUT
				)

			else

				failedServers[
					server.id
				] =
					true

			end

		end


		hopping =
			false


		HopButton.Text =
			"HOP"


		HopButton.TextSize =
			25

	end)

end


HopButton.MouseButton1Click:
	Connect(
