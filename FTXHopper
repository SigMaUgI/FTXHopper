--========================================================
-- SERVER HOP SYSTEM
--========================================================

local hopping =
	false


local visited =
	{}


local failed =
	{}


local pendingServer =
	nil


local hopAttemptToken =
	0


local function executorHttpGet(
	url
)

	local ok,
		result =
		pcall(function()

			return
				game:
					HttpGet(
						url
					)

		end)


	if
		ok
		and result
	then

		return result

	end


	local req =
		request
		or http_request
		or (
			syn
			and syn.request
		)


	if
		type(req)
		== "function"
	then

		local requestOK,
			response =
			pcall(function()

				return req({

					Url =
						url,

					Method =
						"GET"

				})

			end)


		if
			requestOK
			and response
			and response.Body
		then

			return
				response.Body

		end

	end


	return nil

end


local function requestServers(
	cursor,
	order
)

	local url =
		"https://games.roblox.com/v1/games/"
		.. tostring(
			TARGET_PLACE_ID
		)
		.. "/servers/Public?sortOrder="
		.. (
			order
			or "Asc"
		)
		.. "&limit=100"


	if cursor then

		url ..=
			"&cursor="
			.. HttpService:
				UrlEncode(
					cursor
				)

	end


	local body =
		executorHttpGet(
			url
		)


	if not body then
		return nil
	end


	local decodeOK,
		data =
		pcall(function()

			return
				HttpService:
					JSONDecode(
						body
					)

		end)


	if not decodeOK then
		return nil
	end


	return data

end


local function getServers()

	local results =
		{}


	local seen =
		{}


	for _, order in ipairs({
		"Asc",
		"Desc"
	}) do

		local cursor =
			nil


		for _ = 1, 6 do

			local page =
				requestServers(
					cursor,
					order
				)


			if not page then
				break
			end


			for _, server in ipairs(
				page.data
				or {}
			) do

				local id =
					server.id


				local playing =
					tonumber(
						server.playing
					)


				local maxPlayers =
					tonumber(
						server.maxPlayers
					)


				if
					id

					and id ~= game.JobId

					and not seen[id]

					and not visited[id]

					and not failed[id]

					and playing

					and maxPlayers

					and playing < maxPlayers
				then

					seen[id] =
						true


					table.insert(
						results,
						server
					)

				end

			end


			cursor =
				page.nextPageCursor


			if
				not cursor
				or #results >= 120
			then

				break

			end

		end

	end


	return results

end


-- If Roblox tells us a teleport failed,
-- immediately allow the hopper to try again.
pcall(function()

	TeleportService.TeleportInitFailed:
		Connect(function(
			player,
			_,
			_,
			_,
			placeId
		)

			if player ~= LP then
				return
			end


			if
				placeId
				and placeId
					~= TARGET_PLACE_ID
			then

				return

			end


			if pendingServer then

				failed[
					pendingServer
				] =
					true

			end


			pendingServer =
				nil


			hopping =
				false


			HopButton.Text =
				"HOP"


			HopButton.TextSize =
				24

		end)

end)


local function serverHop()

	if hopping then
		return false
	end


	hopping =
		true


	hopAttemptToken +=
		1


	local myToken =
		hopAttemptToken


	local oldJobId =
		game.JobId


	HopButton.Text =
		"FINDING..."


	HopButton.TextSize =
		14


	local servers =
		getServers()


	if #servers == 0 then

		visited =
			{}


		servers =
			getServers()

	end


	if #servers == 0 then

		hopping =
			false


		HopButton.Text =
			"HOP"


		HopButton.TextSize =
			24


		return false

	end


	local server =
		servers[
			RNG:
				NextInteger(
					1,
					#servers
				)
		]


	visited[
		server.id
	] =
		true


	pendingServer =
		server.id


	HopButton.Text =
		"HOPPING..."


	local success =
		pcall(function()

			TeleportService:
				TeleportToPlaceInstance(

					TARGET_PLACE_ID,

					server.id,

					LP

				)

		end)


	if not success then

		failed[
			server.id
		] =
			true


		pendingServer =
			nil


		hopping =
			false


		HopButton.Text =
			"HOP"


		HopButton.TextSize =
			24


		return false

	end


	-- Watchdog:
	-- if the client is STILL in this JobId after
	-- TELEPORT_TIMEOUT, treat the hop as failed.
	task.delay(
		TELEPORT_TIMEOUT,

		function()

			if
				myToken
					~= hopAttemptToken
			then

				return

			end


			if
				game.JobId
				== oldJobId
			then

				if pendingServer then

					failed[
						pendingServer
					] =
						true

				end


				pendingServer =
					nil


				hopping =
					false


				HopButton.Text =
					"HOP"


				HopButton.TextSize =
					24

			end

		end
	)


	return true

end


