	["LEGENDARY"] = true,
	["MYTHIC"] = true

}

local function findBrainrotName(label)

	local gui =
		label:
			FindFirstAncestorWhichIsA(
				"BillboardGui"
			)

		or label:
			FindFirstAncestorWhichIsA(
				"SurfaceGui"
			)

	if not gui then
		return "UNKNOWN"
	end

	local best

	for _, obj in ipairs(
		gui:GetDescendants()
	) do

		if
			obj ~= label
			and (
				obj:IsA("TextLabel")
				or obj:IsA("TextButton")
			)
		then

			local text =
				tostring(obj.Text or "")

			local upper =
				text:upper()

			if
				#text >= 2
				and #text <= 60
				and not parseMoney(text)
				and not blockedNames[upper]
			then

				best = text
				break

			end

		end

	end

	return best or "UNKNOWN"

end

