local recentServers = {}
local recentOrder = {}
local failedServers = {}

for _, id in ipairs(
	Saved.RecentServers or {}
) do

	if
		type(id) == "string"
		and id ~= ""
	then

		recentServers[id] = true

		table.insert(
			recentOrder,
			id
		)

	end

end

local function saveRecent()

	Saved.RecentServers =
		recentOrder

	saveSettings()

end

local function addRecent(id)

	if
		not id
		or id == ""
		or recentServers[id]
	then
		return
	end

	recentServers[id] = true

	table.insert(
		recentOrder,
		id
	)

	while
		#recentOrder
		> MAX_RECENT_SERVERS
	do

		local removed =
			table.remove(
				recentOrder,
				1
			)

		if removed then
			recentServers[removed] = nil
		end

	end

	saveRecent()

end

-- Current server is immediately protected.
addRecent(game.JobId)

local function removeRecent(id)

	if not id then
		return
	end

	recentServers[id] = nil

	for i = #recentOrder, 1, -1 do

		if recentOrder[i] == id then

			table.remove(
				recentOrder,
				i
			)

		end

	end

	saveRecent()

end

local function executorGet(url)

	local success,
		body =
		pcall(function()

			return game:HttpGet(url)

		end)

	if success and body then
		return body
	end

	local req =
		request
		or http_request
		or (
			syn
			and syn.request
		)

	if type(req) == "function" then

		local ok,
			response =
			pcall(function()

				return req({
					Url = url,
					Method = "GET"
				})

			end)

		if
			ok
			and response
			and response.Body
		then

			return response.Body

		end

	end

	return nil

end

local function fetchFastPage(order)

	local url =
		"https://games.roblox.com/v1/games/"
		.. tostring(TARGET_PLACE_ID)
		.. "/servers/Public?sortOrder="
		.. tostring(order)
		.. "&limit="
		.. tostring(SERVER_PAGE_LIMIT)

	local raw =
		executorGet(url)

	if not raw then
		return nil
	end

	local ok,
		data =
		pcall(function()

			return
				HttpService:
					JSONDecode(raw)

		end)

	if not ok or not data then
		return nil
	end

	return data.data or {}

end

local function chooseInstantServer()

	-- Try ASC first.
	local servers =
		fetchFastPage("Asc")

	-- If request failed, instantly try Desc.
	if not servers or #servers == 0 then

		servers =
			fetchFastPage("Desc")

	end

	if not servers then
		return nil
	end

	local fresh = {}
	local fallback = {}

	for _, server in ipairs(servers) do

		local id =
			server.id

		local playing =
			tonumber(
				server.playing
			)

		local maxPlayers =
			tonumber(
				server.maxPlayers
			)

		if
			id
			and id ~= ""
			and id ~= game.JobId
			and not failedServers[id]
			and playing
			and maxPlayers
			and playing < maxPlayers
		then

			-- Preferred:
			-- never used recently.
			if not recentServers[id] then

				table.insert(
					fresh,
					id
				)

			else

				-- Backup only if every visible
				-- server has already been visited.
				table.insert(
					fallback,
					id
				)

			end

		end

	end

	if #fresh > 0 then

		return fresh[
			RNG:NextInteger(
				1,
				#fresh
			)
		]

	end

	-- If first page only contains recent servers,
	-- try opposite ordering immediately.
	local second =
		fetchFastPage("Desc")

	if second then

		for _, server in ipairs(second) do

			local id =
				server.id

			local playing =
				tonumber(
					server.playing
				)

			local maxPlayers =
				tonumber(
					server.maxPlayers
				)

			if
				id
				and id ~= ""
				and id ~= game.JobId
				and not failedServers[id]
				and not recentServers[id]
				and playing
				and maxPlayers
				and playing < maxPlayers
			then

				table.insert(
					fresh,
					id
				)

			end

		end

	end

	if #fresh > 0 then

		return fresh[
			RNG:NextInteger(
				1,
				#fresh
			)
		]

	end

	-- Never pick current JobId.
	-- Old entries are rotated only when needed.
	if #fallback > 0 then

		local removeCount =
			math.max(
				1,
				math.floor(
					#recentOrder / 2
				)
			)

		for _ = 1, removeCount do

			local old =
				table.remove(
					recentOrder,
					1
				)

			if old and old ~= game.JobId then

				recentServers[old] = nil

			elseif old == game.JobId then

				table.insert(
					recentOrder,
					old
				)

			end

		end

		saveRecent()

	end

	return nil

end

local hopping = false

local function resetHopButton()

	HopButton.Text = "HOP"
	HopButton.TextSize = 24

end

local function serverHop()

	if hopping then
		return
	end

	hopping = true

	HopButton.Text =
		"HOPPING..."

	HopButton.TextSize =
		14

	task.spawn(function()

		while
			Gui.Parent
			and hopping
		do

			-- No giant page scan.
			-- Immediately request first page.
			local serverId =
				chooseInstantServer()

			if not serverId then

				HopButton.Text =
					"FINDING..."

				task.wait(
					HOP_RETRY_DELAY
				)

				continue

			end

			-- HARD PROTECTION.
			if
				serverId
				== game.JobId
			then

				failedServers[
					serverId
				] = true

				task.wait()

				continue

			end

			HopButton.Text =
				"HOPPING..."

			local success =
				pcall(function()

					TeleportService:
						TeleportToPlaceInstance(

							TARGET_PLACE_ID,

							serverId,

							LP

						)

				end)

			if success then

				-- Save after Roblox accepted the
				-- teleport request.
				addRecent(
					serverId
				)

				-- Do not sit around with a long watchdog.
				-- Roblox now owns the transition.
				return

			else

				failedServers[
					serverId
				] = true

				removeRecent(
					serverId
				)

				HopButton.Text =
					"RETRYING..."

				task.wait(
					HOP_RETRY_DELAY
				)

			end

		end

		hopping = false
		resetHopButton()

	end)

end

pcall(function()

	TeleportService.TeleportInitFailed:
		Connect(function(
			player,
			_,
			_,
			_,
			_,
			options
		)

			if player ~= LP then
				return
			end

			-- Allow an immediate new attempt.
			hopping = false

			HopButton.Text =
				"RETRYING..."

			task.delay(
				HOP_RETRY_DELAY,
				function()

					resetHopButton()

					if autoHopEnabled then
