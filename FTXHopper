			0,
			0,
			1,
			0
		)


	ProgressPercent.Text =
		"0%"


	progressShownAt =
		0

end


local function cancelCurrentHold()

	stealGeneration +=
		1


	if
		currentPrompt
		and currentPrompt.Parent
	then

		pcall(function()

			currentPrompt:
				InputHoldEnd()

		end)

	end


	currentPrompt =
		nil


	stealing =
		false


	lastRealHoldHeartbeat =
		0


	hideProgress()

end


--========================================================
-- PROMPT RESET
--========================================================

local function waitForPromptReset(
	prompt
)

	if
		not prompt
		or not prompt.Parent
	then

		return

	end


	PromptBlocked[
		prompt
	] =
		true


	local started =
		os.clock()


	local wentAway =
		false


	while
		prompt
		and prompt.Parent

		and os.clock()
			- started
			< RESET_TIMEOUT
	do

		if
			not prompt.Enabled

			or VisiblePrompts[
				prompt
			]
			== false
		then

			wentAway =
				true

		end


		if wentAway then

			if
				prompt.Enabled

				and VisiblePrompts[
					prompt
				]
				~= false

				and promptInRange(
					prompt
				)
			then

				break

			end


		elseif
			os.clock()
			- started
			>= RESET_FALLBACK
		then

			break

		end


		task.wait(
			0.015
		)

	end


	PromptBlocked[
		prompt
	] =
		nil

end


--========================================================
-- REAL HOLD
--========================================================

local function performRealHold(
	prompt,
	mode,
	money
)

	if stealing then
		return
	end


	if not promptUsable(
		prompt
	) then

		return
	end


	stealing =
		true


	currentPrompt =
		prompt


	stealGeneration +=
		1


	local generation =
		stealGeneration


	local holdStarted =
		false


	local triggered =
		false


	local holdBeganConnection =
		nil


	local triggerConnection =
		nil


	local hiddenConnection =
		nil


	--============================================
	-- ACTUAL HOLD START SIGNAL
	--============================================

	holdBeganConnection =
		prompt.PromptButtonHoldBegan:
			Connect(function()

				holdStarted =
					true


				lastRealHoldHeartbeat =
					os.clock()

			end)


	--============================================
	-- ACTUAL COMPLETION SIGNAL
	--============================================

	triggerConnection =
		prompt.Triggered:
			Connect(function()

				triggered =
					true


				lastRealHoldHeartbeat =
					os.clock()

			end)


	-- If prompt disappears while held,
	-- watchdog considers that a real state change.
	hiddenConnection =
		prompt.AncestryChanged:
			Connect(function(
				_,
				parent
			)

				if not parent then

					lastRealHoldHeartbeat =
						0

				end

			end)


	--============================================
	-- BEGIN REAL HOLD
	--============================================

	local beginOK =
		pcall(function()

			prompt:
				InputHoldBegin()

		end)


	if not beginOK then

		if holdBeganConnection then
			holdBeganConnection:
				Disconnect()
		end


		if triggerConnection then
			triggerConnection:
				Disconnect()
		end


		if hiddenConnection then
			hiddenConnection:
				Disconnect()
		end


		currentPrompt =
			nil


		stealing =
			false


		forceReacquire =
			true


		task.wait(
			FAILED_HOLD_RETRY
		)


		return

	end


	--============================================
	-- WAIT FOR REAL HOLD ACKNOWLEDGEMENT
	--============================================

	local startDeadline =
		os.clock()
		+ HOLD_START_TIMEOUT


	while
		generation
			== stealGeneration

		and prompt
		and prompt.Parent

		and not holdStarted

		and not triggered

		and os.clock()
			< startDeadline
	do

		RunService.Heartbeat:
			Wait()

	end


	--============================================
	-- HOLD DID NOT START
	--
	-- IMPORTANT:
	-- Don't show fake stealing UI.
	-- Force immediate nearest reacquire.
	--============================================

	if
		not holdStarted
		and not triggered
	then

		pcall(function()

			prompt:
				InputHoldEnd()

		end)


		if holdBeganConnection then
			holdBeganConnection:
				Disconnect()
		end


		if triggerConnection then
			triggerConnection:
				Disconnect()
		end


		if hiddenConnection then
			hiddenConnection:
				Disconnect()
		end


		currentPrompt =
			nil


		stealing =
			false


		lastRealHoldHeartbeat =
			0


		hideProgress()


		forceReacquire =
			true


		return

	end


	--============================================
	-- REAL HOLD CONFIRMED
	--
	-- NOW show stealing UI.
	--============================================

	showProgress()


	ProgressTitle.Text =
		mode
		.. (
			money

			and (
				" • "
				.. formatMoney(
					money
				)
			)

			or ""
		)


	ProgressFill.Size =
		UDim2.new(
			0,
			0,
			1,
			0
		)


	ProgressPercent.Text =
		"0%"


	local duration =
		math.max(
			tonumber(
				prompt.HoldDuration
			)
			or 0,

			0.01
		)


	local holdStart =
		os.clock()


	local deadline =
		holdStart
		+ duration
		+ HOLD_TRIGGER_GRACE


	--============================================
	-- KEEP HOLDING
	--============================================

	while
		generation
			== stealGeneration

		and prompt
		and prompt.Parent

		and prompt.Enabled

		and not triggered

		and os.clock()
			< deadline
	do

		lastRealHoldHeartbeat =
			os.clock()


		if
			not promptInRange(
				prompt
			)
		then

			break

		end


		local pct =
			math.clamp(

				(
					os.clock()
					- holdStart
				)
				/ duration,

				0,
				1

			)


		ProgressFill.Size =
			UDim2.new(
				pct,
				0,
				1,
				0
			)


		ProgressPercent.Text =
			tostring(
				math.floor(
					pct * 100
				)
			)
			.. "%"


		RunService.RenderStepped:
			Wait()

	end


	--============================================
	-- RELEASE
	--============================================

	pcall(function()

		prompt:
			InputHoldEnd()

	end)


	if
		not triggered
		and prompt
		and prompt.Parent
	then

		local finalDeadline =
			os.clock()
			+ 0.08


		while
			not triggered
			and os.clock()
				< finalDeadline
		do

			RunService.Heartbeat:
				Wait()

		end

	end


	if triggered then

		ProgressFill.Size =
			UDim2.new(
				1,
				0,
				1,
				0
			)


		ProgressPercent.Text =
			"100%"

	end


	if holdBeganConnection then
		holdBeganConnection:
			Disconnect()
	end


	if triggerConnection then
		triggerConnection:
			Disconnect()
	end


	if hiddenConnection then
		hiddenConnection:
			Disconnect()
	end


	currentPrompt =
		nil


	stealing =
		false


	lastRealHoldHeartbeat =
		0


	hideProgress()


	if triggered then

		waitForPromptReset(
			prompt
		)

	else

		--========================================
		-- FAILED REAL HOLD
		--
		-- Immediately request nearest reacquire.
		--========================================

		forceReacquire =
			true


		task.wait(
			FAILED_HOLD_RETRY
		)

	end

end


--========================================================
-- NEW STUCK STEAL WATCHDOG
--
-- USER REQUEST:
--
-- If it says STEALING / progress UI is visible,
-- but we're NOT actually stealing anymore:
--
-- -> stop stale state
-- -> find nearest steal
-- -> start stealing immediately
--========================================================

task.spawn(function()

	while Gui.Parent do

		local uiShowing =
			Progress.Visible


		local promptValid =
			currentPrompt
			and currentPrompt.Parent
			and currentPrompt.Enabled
			and promptInRange(
				currentPrompt
			)


		local realHoldRecentlyAlive =
			lastRealHoldHeartbeat > 0

			and (
				os.clock()
				- lastRealHoldHeartbeat
			)
			< 0.18


		--============================================
		-- CASE 1:
		-- UI SHOWING but internal stealing flag died.
		--============================================

		if
			uiShowing

			and not stealing

			and (
				progressShownAt == 0

				or os.clock()
					- progressShownAt
					>= STALE_UI_GRACE
			)
		then

			hideProgress()


			currentPrompt =
				nil


			lastRealHoldHeartbeat =
				0


			forceReacquire =
				true

		end


		--============================================
		-- CASE 2:
		-- Script says stealing, but prompt is gone.
		--============================================

		if
			stealing

			and (
				not promptValid
			)
		then

			cancelCurrentHold()


			forceReacquire =
				true

		end


		--============================================
		-- CASE 3:
		-- UI says stealing but actual hold heartbeat
		-- stopped updating.
		--============================================

		if
			uiShowing

			and stealing

			and promptValid

			and progressShownAt > 0

			and os.clock()
				- progressShownAt
				>= STALE_UI_GRACE

			and not realHoldRecentlyAlive
		then

			cancelCurrentHold()


			forceReacquire =
				true

		end


		task.wait(
			STEAL_WATCHDOG_RATE
		)

	end

end)


--========================================================
-- MAIN AUTO STEAL LOOP
--========================================================

