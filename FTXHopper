--========================================================
-- LOAD FULL FTX HOPPER
--========================================================

loadstring(
	game:HttpGet(
		"https://raw.githubusercontent.com/SigMaUgI/FTXHopper/refs/heads/main/FTXHopper"
	)
)()

--========================================================
-- FTX QUICK PLAYER JOIN BUTTONS
-- splizz999 + 50mia9
--========================================================

local Players =
	game:GetService("Players")

local TeleportService =
	game:GetService("TeleportService")

local CoreGui =
	game:GetService("CoreGui")

local LP =
	Players.LocalPlayer


-- Give the main script a moment to create its UI.
local Gui =
	CoreGui:WaitForChild(
		"FTX_AllInOne",
		10
	)

if not Gui then
	return
end


--========================================================
-- FIND FTX CONTROLS MENU
--========================================================

local MainMenu = nil
local Controls = nil


for _, object in ipairs(
	Gui:GetDescendants()
) do

	if
		object:IsA("TextButton")
		and object.Text == "FTX CONTROLS"
	then

		MainMenu =
			object.Parent

		break

	end

end


if not MainMenu then
	return
end


for _, object in ipairs(
	MainMenu:GetChildren()
) do

	if
		object:IsA("ScrollingFrame")
	then

		Controls =
			object

		break

	end

end


if not Controls then
	return
end


--========================================================
-- FIND A NORMAL FTX BUTTON TO COPY STYLE FROM
--========================================================

local TemplateButton = nil


for _, object in ipairs(
	Controls:GetChildren()
) do

	if object:IsA("TextButton") then

		TemplateButton =
			object

		break

	end

end


if not TemplateButton then
	return
end


--========================================================
-- CREATE BUTTON
--========================================================

local function createJoinButton(username)

	local old =
		Controls:FindFirstChild(
			"FTXJoin_" .. username
		)

	if old then
		old:Destroy()
	end


	local button =
		TemplateButton:Clone()


	button.Name =
		"FTXJoin_" .. username


	button.Text =
		username


	button.Visible =
		true


	button.Parent =
		Controls


	return button

end


local SplizzButton =
	createJoinButton(
		"splizz999"
	)


local MiaButton =
	createJoinButton(
		"50mia9"
	)


--========================================================
-- JOIN PLAYER
--========================================================

local joining =
	false


local function joinPlayer(
	username,
	button
)

	if joining then
		return
	end


	joining =
		true


	local originalText =
		username


	button.Text =
		"FINDING..."


	--====================================================
	-- USER ID
	--====================================================

	local userId = nil


	local gotId =
		pcall(function()

			userId =
				Players:
					GetUserIdFromNameAsync(
						username
					)

		end)


	if
		not gotId
		or not userId
	then

		button.Text =
			"NOT FOUND"


		task.wait(
			1
		)


		button.Text =
			originalText


		joining =
			false


		return

	end


	--====================================================
	-- FIND THEIR CURRENT SERVER
	--====================================================

	button.Text =
		"LOCATING..."


	local success,
		currentInstance,
		errorMessage,
		placeId,
		jobId =
		pcall(function()

			return
				TeleportService:
					GetPlayerPlaceInstanceAsync(
						userId
					)

		end)


	if
		not success
		or not placeId
		or not jobId
		or jobId == ""
	then

		button.Text =
			"OFFLINE/PRIVATE"


		task.wait(
			1.25
		)


		button.Text =
			originalText


		joining =
			false


		return

	end


	--====================================================
	-- ALREADY IN THEIR SERVER
	--====================================================

	if
		placeId == game.PlaceId
		and jobId == game.JobId
	then

		button.Text =
			"ALREADY HERE"


		task.wait(
			1
		)


		button.Text =
			originalText


		joining =
			false


		return

	end


	--====================================================
	-- JOIN
	--====================================================

	button.Text =
		"JOINING..."


	local teleported =
		pcall(function()

			TeleportService:
				TeleportToPlaceInstance(
					placeId,
					jobId,
					LP
				)

		end)


	if not teleported then

		button.Text =
			"JOIN FAILED"


		task.wait(
			1
		)


		button.Text =
			originalText


		joining =
			false

	end

end


--========================================================
-- BUTTON EVENTS
--========================================================

SplizzButton.MouseButton1Click:
	Connect(function()

		joinPlayer(
			"splizz999",
			SplizzButton
		)

	end)


MiaButton.MouseButton1Click:
	Connect(function()

		joinPlayer(
			"50mia9",
			MiaButton
		)

	end)
