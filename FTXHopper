local kickTriggered = false
local watchedUI = {}

local function checkStole(text)

	if
		not autoKickEnabled
		or kickTriggered
	then

		return

	end

	if typeof(text) ~= "string" then
		return
	end

	if
		text:
			lower():
			find(
				"you stole",
				1,
				true
			)
	then

		kickTriggered = true

		LP:Kick("You stole")

	end

end

local function watchUI(obj)

	if watchedUI[obj] then
		return
	end

	if
		not obj:IsA("TextLabel")
		and not obj:IsA("TextButton")
	then

		return

	end

	watchedUI[obj] = true

	checkStole(obj.Text)

	obj:
		GetPropertyChangedSignal("Text"):
		Connect(function()

			checkStole(obj.Text)

		end)

end

