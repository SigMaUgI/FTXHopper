--========================================================
-- DRAG
--========================================================

local function makeDraggable(
	panel,
	handle,
	saveKey
)

	local dragging = false
	local dragStart
	local startPos

	handle.InputBegan:Connect(function(input)

		if
			input.UserInputType
				== Enum.UserInputType.MouseButton1
			or input.UserInputType
				== Enum.UserInputType.Touch
		then

			dragging = true
			dragStart = input.Position
			startPos = panel.Position

		end

	end)

	handle.InputEnded:Connect(function(input)

		if
			input.UserInputType
				== Enum.UserInputType.MouseButton1
			or input.UserInputType
				== Enum.UserInputType.Touch
		then

			if dragging then

				dragging = false

				if saveKey then

					Saved[saveKey] =
						savePos(
							panel.Position
						)

					saveSettings()

				end

			end

		end

	end)

	UserInputService.InputChanged:Connect(function(input)

		if not dragging then
			return
		end

		if
			input.UserInputType
				~= Enum.UserInputType.MouseMovement
			and input.UserInputType
				~= Enum.UserInputType.Touch
		then

			return

		end

		local delta =
			input.Position
			- dragStart

		panel.Position =
			UDim2.new(

				startPos.X.Scale,

				startPos.X.Offset
					+ delta.X,

				startPos.Y.Scale,

				startPos.Y.Offset
					+ delta.Y

			)

	end)

end

