				)


			if money then

				local distance =
					promptPhysicalDistance(
						prompt
					)


				if
					money > bestMoney

					or (
						money == bestMoney

						and distance < bestDistance
					)
				then

					best =
						prompt


					bestMoney =
						money


					bestDistance =
						distance

				end

			end

		end

	end


	return
		best,
		bestMoney

end


--========================================================
