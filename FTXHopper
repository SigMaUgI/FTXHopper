--========================================================
-- MONEY PARSER
--========================================================

local function parseMoney(text)

	if typeof(text) ~= "string" then
		return nil
	end

	local clean =
		text:
		upper():
		gsub(",", ""):
		gsub("^%s+", ""):
		gsub("%s+$", "")

	local number,
		suffix =
		clean:match(
			"^%$([%d%.]+)([KMBTQ]?)%s*/%s*S$"
		)

	if not number then

		number,
			suffix =
			clean:match(
				"^%$([%d%.]+)([KMBTQ]?)%s*/%s*SEC$"
			)

	end

	if not number then
		return nil
	end

	number = tonumber(number)

	if not number then
		return nil
	end

	local multiplier = 1

	if suffix == "K" then
		multiplier = 1e3

	elseif suffix == "M" then
		multiplier = 1e6

	elseif suffix == "B" then
		multiplier = 1e9

	elseif suffix == "T" then
		multiplier = 1e12

	elseif suffix == "Q" then
		multiplier = 1e15

	end

	return number * multiplier

end

local function formatMoney(value)

	if value >= 1e15 then
		return string.format("$%.2fQ/s", value / 1e15)
	elseif value >= 1e12 then
		return string.format("$%.2fT/s", value / 1e12)
	elseif value >= 1e9 then
		return string.format("$%.2fB/s", value / 1e9)
	elseif value >= 1e6 then
		return string.format("$%.2fM/s", value / 1e6)
	end

	return "$"
		.. tostring(math.floor(value))
		.. "/s"

end

--========================================================
-- FIND WORLD PART
--========================================================

local function getWorldPart(obj)

	local current = obj

	for _ = 1, 20 do

		if not current then
			break
		end

		if
			current:IsA("BillboardGui")
			or current:IsA("SurfaceGui")
		then

			local a =
				current.Adornee

			if a then

				if a:IsA("BasePart") then
					return a
				end

				if
					a:IsA("Attachment")
					and a.Parent
					and a.Parent:IsA("BasePart")
				then

					return a.Parent

				end

			end

		end

		if current:IsA("BasePart") then
			return current
		end

		if current:IsA("Model") then

			return
				current.PrimaryPart
				or current:
					FindFirstChildWhichIsA(
						"BasePart",
						true
					)

		end

		current = current.Parent

	end

	return nil

end

