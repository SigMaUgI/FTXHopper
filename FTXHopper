local BasePart = nil
local BaseBeam = nil
local BaseAttachment = nil


local function findOwnerBase()

	local owner =
		OWNER_NAME:
			lower()


	for _, gui in ipairs(
		workspace:GetDescendants()
	) do

		if
			gui:IsA(
				"BillboardGui"
			)

			or gui:IsA(
				"SurfaceGui"
			)
		then

			for _, object in ipairs(
				gui:GetDescendants()
			) do

				if
					(
						object:IsA(
							"TextLabel"
						)

						or object:IsA(
							"TextButton"
						)
					)

					and tostring(
						object.Text
						or ""
					):
						lower():
						find(
							owner,
							1,
							true
						)
				then

					local part =
						getWorldPart(
							gui
						)


					if part then
						return part
					end

				end

			end

		end

	end


	return nil

end


task.spawn(function()

	while Gui.Parent do

