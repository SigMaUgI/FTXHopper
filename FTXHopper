--========================================================
-- MONEY PARSER
--========================================================

local function parseMoney(text)

	if typeof(text) ~= "string" then
		return nil
	end

	local clean =
		text:
		upper():
		gsub(",", ""):
		gsub("^%s+", ""):
		gsub("%s+$", "")

	local number,
		suffix =
		clean:match(
			"^%$([%d%.]+)([KMBTQ]?)%s*/%s*S$"
		)

	if not number then

		number,
			suffix =
			clean:match(
				"^%$([%d%.]+)([KMBTQ]?)%s*/%s*SEC$"
			)

	end

	if not number then

		number,
			suffix =
			clean:match(
				"^%$([%d%.]+)([KMBTQ]?)%s*PER%s*SEC$"
			)

	end

	if not number then
		return nil
	end

	number =
		tonumber(number)

	if not number then
		return nil
	end

	local multiplier = 1

	if suffix == "K" then
		multiplier = 1e3

	elseif suffix == "M" then
		multiplier = 1e6

	elseif suffix == "B" then
		multiplier = 1e9

	elseif suffix == "T" then
		multiplier = 1e12

	elseif suffix == "Q" then
		multiplier = 1e15

	end

	return
		number
		* multiplier

end

