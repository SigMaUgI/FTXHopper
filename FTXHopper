--========================================================
-- PROXIMITY PROMPTS
--========================================================

local Prompts =
	{}


local VisiblePrompts =
	{}


local PromptBlocked =
	{}


local function isStealPrompt(
	prompt
)

	if
		not prompt
		or not prompt.Parent
		or not prompt.Enabled
	then

		return false

	end


	local action =
		tostring(
			prompt.ActionText
			or ""
		):
		lower()


	local objectText =
		tostring(
			prompt.ObjectText
			or ""
		):
		lower()


	return
		action:
			find(
				"steal",
				1,
				true
			)
			~= nil

		or objectText:
			find(
				"steal",
				1,
				true
			)
			~= nil

end


local function addPrompt(
	object
)

	if object:IsA(
		"ProximityPrompt"
	) then

		Prompts[
			object
		] =
			true

	end

end


for _, object in ipairs(
	workspace:
		GetDescendants()
) do

	addPrompt(
		object
	)

end


workspace.DescendantAdded:
	Connect(
		addPrompt
	)


workspace.DescendantRemoving:
	Connect(function(object)

		Prompts[
			object
		] =
			nil

		VisiblePrompts[
			object
		] =
			nil

		PromptBlocked[
			object
		] =
			nil

	end)


ProximityPromptService.PromptShown:
