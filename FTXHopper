local function checkMoney(object)

	if
		not object
		or not object.Parent
	then

		return

	end


	local value =
		parseMoney(
			object.Text
		)


	if not value then

		MoneyTargets[object] =
			nil

		removeBrainrotESP(
			object
		)

		return

	end


	local part =
		getWorldPart(
			object
		)


	if not part then
		return
	end


	local data = {

		Value = value,
		Part = part,

		Name =
			findBrainrotName(
				object
			),

		Text =
			tostring(
				object.Text
			)

	}


	MoneyTargets[object] =
		data


	if value >= MIN_MONEY then

		if not BrainrotESP[object] then

