local lastRadar = 0

RunService.Heartbeat:Connect(function()

	local root = getRoot()

	if not root then
		return
	end

	if radarCircleEnabled then

		RadarCircle.Transparency = 0.7

		RadarCircle.CFrame =
			CFrame.new(
				root.Position.X,
				root.Position.Y - 2.7,
				root.Position.Z
			)
			* CFrame.Angles(
				0,
				0,
				math.rad(90)
			)

	else

		RadarCircle.Transparency = 1

	end

	local nearby = {}

	for player, data in pairs(
		PlayerESP
	) do

		local other =
			player.Character
			and player.Character:
				FindFirstChild(
					"HumanoidRootPart"
				)

		if
			other
			and data.Highlight
		then

			local distance =
				(
					other.Position
					- root.Position
				).Magnitude

			if not playerHighlightEnabled then

				data.Highlight.Enabled = false

				data.Label.TextColor3 =
					Color3.new(
						1,
						1,
						1
					)

			elseif distance <= RED_RANGE then

				data.Highlight.Enabled = true

				data.Highlight.FillColor =
					Color3.fromRGB(
						255,
						30,
						30
					)

				data.Highlight.OutlineColor =
					Color3.fromRGB(
						255,
						0,
						0
					)

				data.Label.TextColor3 =
					Color3.fromRGB(
						255,
						70,
						70
					)

			elseif distance <= GREEN_RANGE then

				data.Highlight.Enabled = true

				data.Highlight.FillColor =
					Color3.fromRGB(
						40,
						255,
						70
					)

				data.Highlight.OutlineColor =
					Color3.fromRGB(
						20,
						255,
						40
					)

				data.Label.TextColor3 =
					Color3.fromRGB(
						70,
						255,
						95
					)

			else

				data.Highlight.Enabled = false

				data.Label.TextColor3 =
					Color3.new(
						1,
						1,
						1
					)

			end

			if distance <= GREEN_RANGE then

				table.insert(
					nearby,
					{
						Player = player,
						Distance = distance
					}
				)

			end

		end

	end

	if
		os.clock() - lastRadar
		< RADAR_UPDATE_INTERVAL
	then

		return

	end

	lastRadar = os.clock()

	for _, obj in ipairs(
		RadarList:GetChildren()
	) do

		if obj:IsA("TextLabel") then
			obj:Destroy()
		end

	end

	table.sort(
		nearby,
		function(a, b)

			return
				a.Distance
				< b.Distance

		end
	)

	for _, info in ipairs(
		nearby
	) do

		local text =
			Instance.new(
				"TextLabel"
			)

		text.Size =
			UDim2.new(
				1,
				-4,
				0,
				36
			)

		text.BackgroundColor3 =
			Color3.fromRGB(
				23,
				23,
				28
			)

		text.BorderSizePixel = 0

		text.Text =
			info.Player.Name
			.. " • "
			.. string.format(
				"%.1f studs",
				info.Distance
			)

		text.TextColor3 =
			info.Distance <= RED_RANGE
			and Color3.fromRGB(
				255,
				70,
				70
			)

			or Color3.fromRGB(
				80,
				255,
				100
			)

		text.Font =
			Enum.Font.GothamBold

		text.TextSize = 12

		text.Parent =
			RadarList

		corner(text, 8)

	end

end)

