local function getRequestFunction()

	return

		request

		or http_request

		or (
			syn
			and syn.request
		)

end


local function getUserId(
	username
)

	local userId =
		nil


	local ok =
		pcall(function()

			userId =
				Players:
					GetUserIdFromNameAsync(
						username
					)

		end)


	if ok then

		return userId

	end


	return nil

end


local function getPresence(
	userId
)

	--====================================================
	-- METHOD 1
	-- Roblox Presence API
	--====================================================

	local req =
		getRequestFunction()


	if type(req) == "function" then

		local ok,
			response =
			pcall(function()

				return req({

					Url =
						"https://presence.roblox.com/v1/presence/users",

					Method =
						"POST",

					Headers = {

						["Content-Type"] =
							"application/json"

					},

					Body =
						HttpService:
							JSONEncode({

								userIds = {
									userId
								}

							})

				})

			end)


		if
			ok

			and response

			and response.Body
		then

			local decodeOK,
				data =
				pcall(function()

					return
						HttpService:
							JSONDecode(
								response.Body
							)

				end)


			if
				decodeOK

				and data

				and data.userPresences

				and data.userPresences[1]
			then

				local presence =
					data.userPresences[1]


				local presenceType =
					tonumber(
						presence.userPresenceType
					)
					or 0


				local placeId =
					tonumber(
						presence.placeId
					)


				local jobId =
					presence.gameId


				if
					presenceType == 2

					and placeId

					and jobId

					and jobId ~= ""
				then

					return
						placeId,
						jobId

				end

			end

		end

	end


	--====================================================
	-- METHOD 2
	-- Roblox TeleportService fallback
	--====================================================

	local ok,
		currentInstance,
		errorMessage,
		placeId,
		jobId =
		pcall(function()

			return
				TeleportService:
					GetPlayerPlaceInstanceAsync(
						userId
					)

		end)


	if
		ok

		and currentInstance

		and tonumber(
			placeId
		)

		and jobId

		and jobId ~= ""
	then

		return

			tonumber(
				placeId
			),

			jobId

	end


	return
		nil,
		nil

end


