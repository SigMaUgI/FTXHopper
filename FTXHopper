	data
)

	if BrainrotESP[label] then
		return
	end

	local billboard =
		Instance.new(
			"BillboardGui"
		)

	billboard.Adornee =
		data.Part

	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.MaxDistance = 100000

	billboard.Size =
		UDim2.new(
			0,
			390,
			0,
			115
		)

	billboard.StudsOffset =
		Vector3.new(
			0,
			6,
			0
		)

	billboard.Parent =
		ESPFolder

	local text =
		Instance.new(
			"TextLabel"
		)

	text.Size =
		UDim2.fromScale(
			1,
			1
		)

	text.BackgroundTransparency = 1

	text.TextColor3 =
		Color3.fromRGB(
			55,
			255,
			90
		)

	text.TextTransparency = 0.65
	text.TextStrokeTransparency = 0.65

	text.Font =
		Enum.Font.GothamBlack

	text.TextScaled = true

	text.Text =
		tostring(
			data.Name
		)
		.. "\n"
		.. tostring(
			data.Text
		)

	text.Parent =
		billboard

	local attachment =
		Instance.new(
			"Attachment"
		)

	attachment.Parent =
		data.Part

	local beam =
		Instance.new(
			"Beam"
		)

	beam.Attachment0 =
		getRootAttachment()

	beam.Attachment1 =
		attachment

	beam.FaceCamera = true
	beam.Width0 = 0.14
	beam.Width1 = 0.14

	beam.Color =
		ColorSequence.new(
			Color3.fromRGB(
				40,
				255,
				70
			)
		)

	beam.Parent =
		WorldFolder

	BrainrotESP[label] = {

		Gui = billboard,
		Label = text,
		Attachment = attachment,
		Beam = beam

	}
end

local function checkMoney(obj)

	if
		not obj
		or not obj.Parent
	then
		return
	end

	local value =
		parseMoney(
			obj.Text
		)

	if not value then

		MoneyTargets[obj] = nil
		announced[obj] = nil

		removeESP(obj)

		return
	end

	local part =
		getWorldPart(obj)

	if not part then
		return
	end

	local data = {

		Value = value,
		Part = part,

		Name =
			findBrainrotName(
				obj
			),

		Text =
			tostring(
				obj.Text
			)
	}

	MoneyTargets[obj] =
		data

	if value >= MIN_MONEY then

		if not announced[obj] then

			announced[obj] = true

			playGoodSound()
		end

		if not BrainrotESP[obj] then

			createESP(
				obj,
				data
			)

		else

			BrainrotESP[obj].Label.Text =
				data.Name
				.. "\n"
				.. data.Text
		end

	else

		announced[obj] = nil

		removeESP(obj)
	end
end

local function watchMoney(obj)

	if WatchedMoney[obj] then
		return
	end

	if
		not obj:IsA(
			"TextLabel"
		)
		and
		not obj:IsA(
			"TextButton"
		)
	then
		return
	end

	WatchedMoney[obj] = true

	checkMoney(obj)

	obj:
		GetPropertyChangedSignal(
			"Text"
		):
		Connect(function()

			checkMoney(obj)

		end)
end

local function scanMoney()

	for index, obj in ipairs(
		workspace:GetDescendants()
	) do

		if
			obj:IsA(
				"TextLabel"
			)
			or
			obj:IsA(
				"TextButton"
			)
		then

			watchMoney(obj)
			checkMoney(obj)
		end

		if index % 500 == 0 then
			task.wait()
		end
	end
end

task.spawn(
	scanMoney
)

workspace.DescendantAdded:
	Connect(
		watchMoney
	)

task.spawn(function()

	while Gui.Parent do

		task.wait(
			MONEY_SCAN_RATE
		)

		scanMoney()

	end
end)

