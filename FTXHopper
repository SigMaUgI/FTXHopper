	return character:
		FindFirstChild(
			"HumanoidRootPart"
		)

end

local function getRootAttachment()

	local root =
		getRoot()

	if not root then
		return nil
	end

	if
		RootAttachment
		and RootAttachment.Parent == root
	then

		return RootAttachment

	end

	RootAttachment =
		root:FindFirstChild(
			"FTX_ROOT"
		)

	if not RootAttachment then

		RootAttachment =
			Instance.new(
				"Attachment"
			)

		RootAttachment.Name =
			"FTX_ROOT"

		RootAttachment.Parent =
			root

	end

	return RootAttachment

end

