local hopping =
	false


local visited =
	{}


local function requestPage(cursor)

	local url =
		"https://games.roblox.com/v1/games/"
		.. tostring(
			TARGET_PLACE_ID
		)
		.. "/servers/Public?sortOrder=Asc&limit=100"


	if cursor then

		url ..=
			"&cursor="
			.. HttpService:
				UrlEncode(
					cursor
				)

	end


	local ok,
		response =
		pcall(function()

			return
				game:HttpGet(
					url
				)

		end)


	if not ok then
		return nil
	end


	local decodedOK,
		data =
		pcall(function()

			return
				HttpService:
					JSONDecode(
						response
					)

		end)


	if not decodedOK then
		return nil
	end


	return data

end


local function getServers()

	local results = {}

	local cursor = nil


	for _ = 1, 6 do

		local page =
			requestPage(
				cursor
			)


		if not page then
			break
		end


		for _, server in ipairs(
			page.data
			or {}
		) do

			if
				server.id

				and server.id
					~= game.JobId

				and not visited[
					server.id
				]

				and tonumber(
					server.playing
				)

				and tonumber(
					server.maxPlayers
				)

				and tonumber(
					server.playing
				)
					< tonumber(
						server.maxPlayers
					)
			then

				table.insert(
					results,
					server
				)

			end

		end


		cursor =
			page.nextPageCursor


		if
			not cursor
			or #results >= 100
		then

			break

		end

	end


	return results

end


local function serverHop()

	if hopping then
		return
	end


	hopping =
		true


	HopButton.Text =
		"FINDING..."


	task.spawn(function()

		local servers =
			getServers()


		if #servers == 0 then

			visited =
				{}

			servers =
				getServers()

		end


		if #servers > 0 then

			local server =
				servers[
					RNG:
						NextInteger(
							1,
							#servers
						)
				]


			visited[
				server.id
			] =
				true


			HopButton.Text =
				"HOPPING..."


			pcall(function()

				TeleportService:
					TeleportToPlaceInstance(

						TARGET_PLACE_ID,

						server.id,

						LP

					)

			end)


			task.wait(
				TELEPORT_TIMEOUT
			)

		end


		hopping =
			false


		HopButton.Text =
			"HOP"

	end)

end


