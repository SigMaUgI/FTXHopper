			"FTX_ROOT"

		RootAttachment.Parent =
			root

	end


	return
		RootAttachment

end


--========================================================
-- DISTANCE
--========================================================

local function horizontalDistance(
	a,
	b
)

	local dx =
		a.X - b.X


	local dz =
		a.Z - b.Z


	return
		math.sqrt(
			dx * dx
			+ dz * dz
		)

end


local function closestPointDistance(
	position,
	part
)

	if
		not part
		or not part.Parent
	then

		return math.huge

	end


	local localPosition =
		part.CFrame:
			PointToObjectSpace(
				position
			)


	local half =
		part.Size / 2


	local closest =
		Vector3.new(

			math.clamp(
				localPosition.X,
				-half.X,
				half.X
			),

			math.clamp(
				localPosition.Y,
				-half.Y,
				half.Y
			),

			math.clamp(
				localPosition.Z,
				-half.Z,
				half.Z
			)

		)


	local world =
		part.CFrame:
			PointToWorldSpace(
				closest
			)


	return
		horizontalDistance(
			position,
			world
		)

end


--========================================================
-- MONEY PARSER
--========================================================

local function parseMoney(
	text
)

	if
		typeof(text)
		~= "string"
	then

		return nil

	end


	local clean =
		text
			:upper()
			:gsub(",", "")
			:gsub("^%s+", "")
			:gsub("%s+$", "")


	local number,
		suffix =
		clean:
			match(
				"^%$([%d%.]+)([KMBTQ]?)%s*/%s*S$"
			)


	if not number then

		number,
			suffix =
			clean:
				match(
					"^%$([%d%.]+)([KMBTQ]?)%s*/%s*SEC$"
				)

	end


	if not number then

		number,
			suffix =
			clean:
				match(
					"^%$([%d%.]+)([KMBTQ]?)%s*PER%s*SEC$"
				)

	end


	number =
		tonumber(
			number
		)


	if not number then
		return nil
	end


	local multiplier =
		1


	if suffix == "K" then

		multiplier =
			1e3

	elseif suffix == "M" then

		multiplier =
			1e6

	elseif suffix == "B" then

		multiplier =
			1e9

	elseif suffix == "T" then

		multiplier =
			1e12

	elseif suffix == "Q" then

		multiplier =
			1e15

	end


	return
		number
		* multiplier

end


local function formatMoney(
	value
)

	if not value then
		return "$0/s"
	end


	if value >= 1e15 then

		return string.format(
			"$%.2fQ/s",
			value / 1e15
		)

	elseif value >= 1e12 then

		return string.format(
			"$%.2fT/s",
			value / 1e12
		)

	elseif value >= 1e9 then

		return string.format(
			"$%.2fB/s",
			value / 1e9
		)

	elseif value >= 1e6 then

		return string.format(
			"$%.2fM/s",
			value / 1e6
		)

	elseif value >= 1e3 then

		return string.format(
			"$%.2fK/s",
			value / 1e3
		)

	end


	return
		"$"
		.. tostring(
			math.floor(
				value
			)
		)
		.. "/s"

end


--========================================================
-- WORLD PART FINDER
--========================================================

local function getWorldPart(
	object
)

	local current =
		object


	for _ = 1, 24 do

		if not current then
			break
		end


		if
			current:IsA(
				"BillboardGui"
			)

			or current:IsA(
				"SurfaceGui"
			)
		then

			local adornee =
				current.Adornee


			if adornee then

				if
					adornee:IsA(
						"BasePart"
					)
				then

					return
						adornee

				end


				if
					adornee:IsA(
						"Attachment"
					)

					and adornee.Parent

					and adornee.Parent:
						IsA(
							"BasePart"
						)
				then

					return
						adornee.Parent

				end

			end

		end


		if
			current:IsA(
				"BasePart"
			)
		then

			return
				current

		end


		if current:IsA(
			"Model"
		) then

			if current.PrimaryPart then

				return
					current.PrimaryPart

			end


			local part =
				current:
					FindFirstChildWhichIsA(
						"BasePart",
						true
					)


			if part then
				return part
			end

		end


		current =
			current.Parent

	end


	return nil

end


--========================================================
-- BRAINROT NAME
--========================================================

local ignoredWords = {

	"SECRET",
	"GOLD",
	"RADIOACTIVE",
	"CANDY",
	"DIAMOND",
	"CYBER",
	"STOLEN",
	"COLLECT",
	"OFFLINE CASH",
	"COMMON",
	"RARE",
	"EPIC",
	"LEGENDARY",
	"MYTHIC",
	"OG",
	"BRAINROT GOD",
	"STEAL"

}


local function invalidBrainrotName(
	text
)

	if
		not text
		or text == ""
	then

		return true

	end


	if parseMoney(
		text
	) then

		return true

	end


	local upper =
		text:
			upper()


	if upper:find(
		"$",
		1,
		true
	) then

		return true

	end


	for _, word in ipairs(
		ignoredWords
	) do

		if
			upper == word

			or upper:find(
				word,
				1,
				true
			)
		then

			return true

		end

	end


	return false

end


local function findBrainrotName(
	label
)

	local gui =
		label:
			FindFirstAncestorWhichIsA(
				"BillboardGui"
			)

		or label:
			FindFirstAncestorWhichIsA(
				"SurfaceGui"
			)

		or label.Parent


	if not gui then
		return "UNKNOWN"
	end


	local center =
		label.AbsolutePosition
		+ label.AbsoluteSize / 2


	local best =
		nil


	local bestScore =
		-math.huge


	for _, object in ipairs(
		gui:
			GetDescendants()
	) do

		if
			object ~= label

			and (
				object:IsA(
					"TextLabel"
				)

				or object:IsA(
					"TextButton"
				)
			)
		then

			local text =
				tostring(
					object.Text
					or ""
				)


			if
				not invalidBrainrotName(
					text
				)

				and #text >= 2

				and #text <= 70
			then

				local other =
					object.AbsolutePosition
					+ object.AbsoluteSize / 2


				local dx =
					math.abs(
						other.X
						- center.X
					)


				local dy =
					center.Y
					- other.Y


				local score =
					0


				if
					object.Parent
					== label.Parent
				then

					score +=
						1000

				end


				if
					dy >= -10
					and dy <= 170
				then

					score +=
						500
						- math.abs(
							dy
						)

				end


				score +=
					math.max(
						0,
						300 - dx
					)


				if score > bestScore then

					bestScore =
						score

					best =
						text

				end

			end

		end

	end


	return
		best
		or "UNKNOWN"

end


