local SelectedBeam
local SelectedAttachment

local function selectBrainrot(data)

	if SelectedBeam then

		SelectedBeam:Destroy()
		SelectedBeam = nil
	end

	if SelectedAttachment then

		SelectedAttachment:Destroy()
		SelectedAttachment = nil
	end

	if
		not data
		or not data.Part
		or not data.Part.Parent
	then
		return
	end

	SelectedAttachment =
		Instance.new(
			"Attachment"
		)

	SelectedAttachment.Parent =
		data.Part

	SelectedBeam =
		Instance.new(
			"Beam"
		)

	SelectedBeam.Attachment0 =
		getRootAttachment()

	SelectedBeam.Attachment1 =
		SelectedAttachment

	SelectedBeam.FaceCamera = true
	SelectedBeam.Width0 = 0.3
	SelectedBeam.Width1 = 0.3

	SelectedBeam.Color =
		ColorSequence.new(
			Color3.fromRGB(
				255,
				200,
				30
			)
		)

	SelectedBeam.Parent =
		WorldFolder
end

local function refreshBrainrotList()

	for _, object in ipairs(
		BrainrotList:GetChildren()
	) do

		if object:IsA(
			"TextButton"
		) then

			object:Destroy()
		end
	end

	local entries = {}

	for label, data in pairs(
		MoneyTargets
	) do

		if
			label
			and label.Parent
			and data
			and data.Value >= MIN_MONEY
			and data.Part
			and data.Part.Parent
		then

			table.insert(
				entries,
				data
			)
		end
	end

	table.sort(
		entries,
		function(a, b)

			return
				a.Value
				> b.Value
		end
	)

	for index, data in ipairs(
		entries
	) do

		local row =
			Instance.new(
				"TextButton"
			)

		row.LayoutOrder = index

		row.Size =
			UDim2.new(
				1,
				-4,
				0,
				50
			)

		row.BackgroundColor3 =
			Color3.fromRGB(
				23,
				23,
				28
			)

		row.BorderSizePixel = 0

		row.Text =
			"#"
			.. tostring(index)
			.. "  "
			.. tostring(
				data.Name
				or "UNKNOWN"
			)
			.. "\n"
			.. tostring(
				data.Text
			)

		row.TextColor3 =
			Color3.fromRGB(
				230,
				230,
				230
			)

		row.Font =
			Enum.Font.GothamBold

		row.TextSize = 12
		row.Parent = BrainrotList

		corner(
			row,
			9
		)

		row.MouseButton1Click:
			Connect(function()

				selectBrainrot(
					data
				)
			end)
	end

	BrainrotTitle.Text =
		"BRAINROTS $20M+ • "
		.. tostring(
			#entries
		)
end

