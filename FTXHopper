--========================================================
-- AUTO HOP
--
-- BEHAVIOR:
--
-- 1. Wait 3 seconds after joining.
--
-- 2. If Auto Hop carried over from the previous server:
--      $20M+ = TURN OFF.
--      No $20M+ = HOP.
--
-- 3. If YOU manually turn Auto Hop ON:
--      ignore $20M+ in CURRENT server once.
--      hop anyway.
--
-- 4. After the hop the script reloads,
--    autoHopManuallyRestarted becomes FALSE.
--
-- 5. Therefore the NEXT $20M+ server stops Auto Hop.
--========================================================

local function stopAutoHop()

	autoHopEnabled = false

	autoHopManuallyRestarted =
		false

	Saved.AutoHop = false

	refreshButtons()
	saveSettings()
end

task.spawn(function()

	while Gui.Parent do

		if autoHopEnabled then

			local elapsed =
				os.clock()
				- JOIN_TIME

			if
				elapsed
				>= AUTO_HOP_JOIN_WAIT
			then

				--====================================
				-- MANUALLY TURNED ON
				--
				-- LEAVE CURRENT SERVER EVEN IF GOOD.
				--====================================

				if autoHopManuallyRestarted then

					if not hopping then

						-- Consume the one-time override.

						autoHopManuallyRestarted =
							false

						serverHop()
					end

				else

					--================================
					-- NORMAL AUTO-HOP SCAN
					--================================

					scanMoney()

					local found =
						hasGoodBrainrot()

					if found then

						-- GOOD SERVER:
						-- TURN AUTO HOP OFF.

						stopAutoHop()

						hopping = false

						resetHopButton()

					elseif not hopping then

						-- NOTHING GOOD:
						-- KEEP HOPPING.

						serverHop()
					end
				end
			end
		end

		task.wait(0.1)
	end
end)

