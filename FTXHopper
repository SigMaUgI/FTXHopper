local function checkMoney(
	object
)

	if
		not object
		or not object.Parent
	then

		return

	end


	local value =
		parseMoney(
			object.Text
		)


	if not value then

		MoneyTargets[
			object
		] =
			nil


		removeBrainrotESP(
			object
		)


		return

	end


	local part =
		getWorldPart(
			object
		)


	if not part then
		return
	end


	local data = {

		Value =
			value,

		Part =
			part,

		Name =
			findBrainrotName(
				object
			),

		Text =
			tostring(
				object.Text
			)

	}


	MoneyTargets[
		object
	] =
		data


	if value >= MIN_MONEY then

		if not BrainrotESP[
			object
		] then

			createBrainrotESP(
				object,
				data
			)

		else

			BrainrotESP[
				object
			].Update()

		end

	else

		removeBrainrotESP(
			object
		)

	end

end


local function watchMoney(
	object
)

	if WatchedMoney[
		object
	] then

		return

	end


	if
		not object:IsA(
			"TextLabel"
		)

		and not object:IsA(
			"TextButton"
		)
	then

		return

	end


	WatchedMoney[
		object
	] =
		true


	checkMoney(
		object
	)


	object:
		GetPropertyChangedSignal(
			"Text"
		):
		Connect(function()

			checkMoney(
				object
			)

		end)

end


local function scanMoney()

	for index,
		object in ipairs(
			workspace:
				GetDescendants()
		)
	do

		if
			object:IsA(
				"TextLabel"
			)

			or object:IsA(
				"TextButton"
			)
		then

			watchMoney(
				object
			)

			checkMoney(
				object
			)

		end


		if index % 500 == 0 then
			task.wait()
		end

	end

end


