local function isStealPrompt(
	prompt
)

	if
		not prompt
		or not prompt.Parent
		or not prompt.Enabled
	then

		return false

	end


	local a =
		tostring(
			prompt.ActionText
			or ""
		):
			lower()


	local b =
		tostring(
			prompt.ObjectText
			or ""
		):
			lower()


	return

		a:find(
			"steal",
			1,
			true
		)

		or b:find(
			"steal",
			1,
			true
		)

end


local function promptPosition(
	prompt
)

	if
		not prompt
		or not prompt.Parent
	then

		return nil

	end


	if prompt.Parent:IsA(
		"Attachment"
	) then

		return
			prompt.Parent.WorldPosition

	end


	if prompt.Parent:IsA(
		"BasePart"
	) then

		return
			prompt.Parent.Position

	end


	local model =
		prompt.Parent:
			FindFirstAncestorWhichIsA(
				"Model"
			)


	if model then

		local part =

			model.PrimaryPart

			or model:
				FindFirstChildWhichIsA(
					"BasePart",
					true
				)


		if part then

			return
				part.Position

		end

	end


	return nil

end


local function promptDistance(
	prompt
)

	local root =
		getRoot()


	local pos =
		promptPosition(
			prompt
		)


	if
		not root
		or not pos
	then

		return
			math.huge

	end


	return
		(
			root.Position
			- pos
		).Magnitude

end


local function getNearestPrompt()

	local best =
		nil

	local bestDistance =
		math.huge


	for prompt in pairs(
		Prompts
	) do

		if isStealPrompt(
			prompt
		) then

			local distance =
				promptDistance(
					prompt
				)


			local maximum =
				tonumber(
					prompt.MaxActivationDistance
				)
				or 10


			if
				distance
					<= maximum + 0.75

				and distance
					< bestDistance
			then

				best =
					prompt

				bestDistance =
					distance

			end

		end

	end


	return best

end


local function getPromptMoney(
	prompt
)

	local pos =
		promptPosition(
			prompt
		)


	if not pos then
		return nil
	end


	local bestDistance =
		math.huge

	local money =
		nil


	for _, data in pairs(
		MoneyTargets
	) do

		if
			data.Part
			and data.Part.Parent
		then

			local distance =
				(
					data.Part.Position
					- pos
				).Magnitude


			if
				distance
					< bestDistance

				and distance
					<= 25
			then

				bestDistance =
					distance

				money =
					data.Value

			end

		end

	end


	return money

end


local function getHighestPrompt()

	local best =
		nil

	local bestMoney =
		-math.huge


	for prompt in pairs(
		Prompts
	) do

		if isStealPrompt(
			prompt
		) then

			local distance =
				promptDistance(
					prompt
				)


			local maximum =
				tonumber(
					prompt.MaxActivationDistance
				)
				or 10


			if
				distance
					<= maximum + 0.75
			then

				local money =
					getPromptMoney(
						prompt
					)


				if
					money
					and money
						> bestMoney
				then

					bestMoney =
						money

					best =
						prompt

				end

			end

		end

	end


	return best

end


local stealing =
	false


local currentPrompt =
	nil


local function holdPrompt(
	prompt
)

	if
		stealing
		or not prompt
		or not prompt.Parent
	then

		return

	end


	stealing =
		true

	currentPrompt =
		prompt


	local duration =
		math.max(
			tonumber(
				prompt.HoldDuration
			)
				or 0,
			0.05
		)


	Progress.Visible =
		true


	ProgressText.Text =
		"STEALING  "
		.. tostring(
			prompt.ObjectText
			or ""
		)


	ProgressFill.Size =
		UDim2.new(
			0,
			0,
			1,
			0
		)


	local tween =
		TweenService:
			Create(

				ProgressFill,

				TweenInfo.new(
					duration,
					Enum.EasingStyle.Linear
				),

				{
					Size =
						UDim2.new(
							1,
							0,
							1,
							0
						)
				}

			)


	pcall(function()

		prompt:
			InputHoldBegin()

	end)


	tween:Play()


	task.wait(
		duration + 0.04
	)


	pcall(function()

		prompt:
			InputHoldEnd()

	end)


	Progress.Visible =
		false


	currentPrompt =
		nil

	stealing =
		false

end


task.spawn(function()

	while Gui.Parent do

		if not stealing then

			local prompt =
				nil


			if nearestEnabled then

				prompt =
					getNearestPrompt()

			elseif highestEnabled then

				prompt =
					getHighestPrompt()

			end


			if prompt then

				task.spawn(
					holdPrompt,
					prompt
				)

			end

		end


		task.wait(
			STEAL_SCAN_RATE
		)

	end

end)


