local function corner(parent, radius)

	local c = Instance.new("UICorner")

	c.CornerRadius = UDim.new(
		0,
		radius or 12
	)

	c.Parent = parent

	return c

end


local function stroke(
	parent,
	thickness,
	color
)

	local s = Instance.new("UIStroke")

	s.Thickness = thickness or 2

	s.Color =
		color
		or Color3.fromRGB(
			90,
			90,
			95
		)

	s.Parent = parent

	return s

end


