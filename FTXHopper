end


local function scanMoney()

	for index, object in ipairs(
		workspace:
			GetDescendants()
	) do

		if
			object:IsA(
				"TextLabel"
			)

			or object:IsA(
				"TextButton"
			)
		then

			watchMoney(
				object
			)


			checkMoney(
				object
			)

		end


		if
			index % 500
			== 0
		then

			task.wait()

		end

	end

end


