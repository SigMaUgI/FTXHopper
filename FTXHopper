local joiningTarget = false

local function getRequestFunction()

	return
		request
		or http_request
		or (
			syn
			and syn.request
		)
end

local function getUserId(username)

	local userId

	local success =
		pcall(function()

			userId =
				Players:
					GetUserIdFromNameAsync(
						username
					)
		end)

	if success then
		return userId
	end
end

local function getPresence(userId)

	local req =
		getRequestFunction()

	--============================================
	-- PRESENCE API
	--============================================

	if type(req) == "function" then

		local success,
			response =
			pcall(function()

				return req({

					Url =
						"https://presence.roblox.com/v1/presence/users",

					Method =
						"POST",

					Headers = {
						["Content-Type"] =
							"application/json"
					},

					Body =
						HttpService:
							JSONEncode({
								userIds = {
									userId
								}
							})
				})
			end)

		if
			success
			and response
			and response.Body
		then

			local decodedSuccess,
				decoded =
				pcall(function()

					return
						HttpService:
							JSONDecode(
								response.Body
							)
				end)

			if
				decodedSuccess
				and decoded
				and decoded.userPresences
				and decoded.userPresences[1]
			then

				local presence =
					decoded.userPresences[1]

				local placeId =
					tonumber(
						presence.placeId
					)

				local jobId =
					presence.gameId

				local presenceType =
					tonumber(
						presence.userPresenceType
					)
					or 0

				if
					presenceType == 2
					and placeId
					and jobId
					and jobId ~= ""
				then

					return placeId, jobId
				end
			end
		end
	end

	--============================================
	-- BUILT-IN FALLBACK
	--============================================

	local success,
		currentInstance,
		errorMessage,
		placeId,
		jobId =
		pcall(function()

			return
				TeleportService:
					GetPlayerPlaceInstanceAsync(
						userId
					)
		end)

	if
		success
		and currentInstance
		and tonumber(placeId)
		and jobId
		and jobId ~= ""
	then

		return
			tonumber(placeId),
			jobId
	end
end

local function joinPlayer(
	username,
	button
)

	if joiningTarget then
		return
	end

	joiningTarget = true

	button.Text =
		"LOCATING..."

	local userId =
		getUserId(username)

	if not userId then

		button.Text =
			"USER NOT FOUND"

		task.wait(1)

		button.Text =
			username

		joiningTarget = false

		return
	end

	local placeId,
		jobId =
		getPresence(userId)

	if
		not placeId
		or not jobId
	then

		button.Text =
			"OFFLINE / PRIVATE"

		task.wait(1.25)

		button.Text =
			username

		joiningTarget = false

		return
	end

	if
		placeId == game.PlaceId
		and jobId == game.JobId
	then

		button.Text =
			"ALREADY HERE"

		task.wait(1)

		button.Text =
			username

		joiningTarget = false

		return
	end

	-- Stop Auto Hop when manually joining them.

	autoHopEnabled = false

	autoHopManuallyRestarted =
		false

	Saved.AutoHop = false

	refreshButtons()
	saveSettings()

	button.Text =
		"JOINING..."

	local success =
		pcall(function()

			TeleportService:
				TeleportToPlaceInstance(
					placeId,
					jobId,
					LP
				)
		end)

	if not success then

		button.Text =
			"JOIN FAILED"

		task.wait(1)

		button.Text =
			username

		joiningTarget = false
	end
end

