local Prompts = {}
local VisiblePrompts = {}
local PromptBlocked = {}


local function isStealPrompt(prompt)

	if
		not prompt
		or not prompt.Parent
		or not prompt.Enabled
	then

		return false

	end


	local action =
		tostring(
			prompt.ActionText
			or ""
		):
		lower()


	local objectText =
		tostring(
			prompt.ObjectText
			or ""
		):
		lower()


	return
		action:find(
			"steal",
			1,
			true
		)
		~= nil

		or objectText:find(
			"steal",
			1,
			true
		)
		~= nil

end


local function addPrompt(object)

	if object:IsA(
		"ProximityPrompt"
	) then

		Prompts[object] =
			true

	end

end


for _, object in ipairs(
	workspace:GetDescendants()
) do

	addPrompt(
		object
	)

end


workspace.DescendantAdded:
	Connect(
		addPrompt
	)


workspace.DescendantRemoving:
	Connect(function(object)

		Prompts[object] =
			nil

		VisiblePrompts[object] =
			nil

		PromptBlocked[object] =
			nil

	end)


ProximityPromptService.PromptShown:
	Connect(function(prompt)

		VisiblePrompts[prompt] =
			true

	end)


ProximityPromptService.PromptHidden:
	Connect(function(prompt)

		VisiblePrompts[prompt] =
			false

	end)


local function promptPosition(prompt)

	if
		not prompt
		or not prompt.Parent
	then

		return nil

	end


	if prompt.Parent:IsA(
		"Attachment"
	) then

		return
			prompt.Parent.WorldPosition

	end


	if prompt.Parent:IsA(
		"BasePart"
	) then

		return
			prompt.Parent.Position

	end


	local part =
		prompt.Parent:
			FindFirstAncestorWhichIsA(
				"BasePart"
			)


	if part then
		return part.Position
	end


	return nil

end


local function promptInRange(prompt)

	if not isStealPrompt(
		prompt
	) then

		return false

	end


	local root =
		getRoot()


	local pos =
		promptPosition(
			prompt
		)


	if
		not root
		or not pos
	then

		return false

	end


	local range =
		tonumber(
			prompt.MaxActivationDistance
		)
		or 10


	return
		(
			root.Position
			- pos
		).Magnitude

		<= range + 0.75

end


local function promptUsable(prompt)

	if not promptInRange(
		prompt
	) then

		return false

	end


	if PromptBlocked[prompt] then
		return false
	end


	if
		VisiblePrompts[prompt]
		== false
	then

		return false

	end


	return true

end


local function getNearestSteal()

	local root =
		getRoot()


	if not root then
		return nil
	end


	local best =
		nil


	local bestDistance =
		math.huge


	for prompt in pairs(
		Prompts
	) do

		if promptUsable(
			prompt
		) then

			local pos =
				promptPosition(
					prompt
				)


			if pos then

				local distance =
					(
						root.Position
						- pos
					).Magnitude


				if
					distance
					< bestDistance
				then

					bestDistance =
						distance

					best =
						prompt

				end

			end

		end

	end


	return best

end


local function promptMoney(prompt)

	local pos =
		promptPosition(
			prompt
		)


	if not pos then
		return nil
	end


	local closest =
		math.huge


	local result =
		nil


	for _, data in pairs(
		MoneyTargets
	) do

		if
			data.Part
			and data.Part.Parent
		then

			local d =
				(
					pos
					- data.Part.Position
				).Magnitude


			if
				d < closest
				and d <= 25
			then

				closest =
					d

				result =
					data.Value

			end

		end

	end


	return result

end


local function getHighestSteal()

	local best =
		nil


	local bestMoney =
		-math.huge


	for prompt in pairs(
		Prompts
	) do

		if promptUsable(
			prompt
		) then

			local money =
				promptMoney(
					prompt
				)


			if
				money
				and money > bestMoney
			then

				bestMoney =
					money

				best =
					prompt

			end

		end

	end


	return
		best,
		bestMoney

end


--========================================================
-- STEAL
--========================================================

local stealing = false
local currentPrompt = nil
local stealGeneration = 0


local function hideProgress()

	Progress.Visible =
		false

	ProgressFill.Size =
		UDim2.new(
			0,
			0,
			1,
			0
		)

	ProgressPercent.Text =
		"0%"

end


local function cancelCurrentHold()

	stealGeneration += 1


	if
		currentPrompt
		and currentPrompt.Parent
	then

		pcall(function()

			currentPrompt:
				InputHoldEnd()

		end)

	end


	currentPrompt = nil
	stealing = false

	hideProgress()

end


local function performHold(
	prompt,
	title,
	money
)

	if stealing then
		return
	end


	if not promptUsable(
		prompt
	) then

		return

	end


	stealing = true

	currentPrompt =
		prompt

	stealGeneration += 1

	local generation =
		stealGeneration


	local holdStarted =
		false


	local triggered =
		false


	local startConnection =
		prompt.PromptButtonHoldBegan:
			Connect(function()

				holdStarted =
					true

			end)


	local triggerConnection =
		prompt.Triggered:
			Connect(function()

				triggered =
					true

			end)


	local success =
		pcall(function()

			prompt:
				InputHoldBegin()

		end)


	if not success then

		startConnection:
			Disconnect()

		triggerConnection:
			Disconnect()

		currentPrompt =
			nil

		stealing =
			false

		return

	end


	local deadline =
		os.clock()
		+ HOLD_START_TIMEOUT


	while
		not holdStarted
		and not triggered
		and prompt.Parent
		and os.clock() < deadline
	do

		RunService.Heartbeat:
			Wait()

	end


	if
		not holdStarted
		and not triggered
	then

		pcall(function()

			prompt:
				InputHoldEnd()

		end)

		startConnection:
			Disconnect()

		triggerConnection:
			Disconnect()

		currentPrompt =
			nil

		stealing =
			false

		return

	end


	Progress.Visible =
		true


	ProgressTitle.Text =
		title
		.. (
			money

			and (
				" • "
				.. formatMoney(
					money
				)
			)

			or ""
		)


	local duration =
		math.max(
			prompt.HoldDuration,
			0.01
		)


	local started =
		os.clock()


	while
		generation
			== stealGeneration

		and prompt.Parent

		and prompt.Enabled

		and promptInRange(
			prompt
		)

		and not triggered

		and os.clock()
			- started
			<= duration
				+ HOLD_TRIGGER_GRACE
	do

		local pct =
			math.clamp(

				(
					os.clock()
					- started
				)
				/ duration,

				0,
				1

			)


		ProgressFill.Size =
			UDim2.new(
				pct,
				0,
				1,
				0
			)


		ProgressPercent.Text =
			tostring(
				math.floor(
					pct * 100
				)
			)
			.. "%"


		RunService.RenderStepped:
			Wait()

	end


	pcall(function()

		prompt:
			InputHoldEnd()

	end)


	startConnection:
		Disconnect()

	triggerConnection:
		Disconnect()


	currentPrompt =
		nil

	stealing =
		false

	hideProgress()


	if triggered then

		PromptBlocked[prompt] =
			true


		task.delay(
			RESET_FALLBACK,

			function()

				PromptBlocked[prompt] =
					nil

			end
		)

	else

		task.wait(
			FAILED_HOLD_RETRY
		)

	end

end


task.spawn(function()

	while Gui.Parent do

		if not stealing then

			if nearestEnabled then

				local prompt =
					getNearestSteal()


				if prompt then

					performHold(

						prompt,

						"NEAREST STEAL",

						promptMoney(
							prompt
						)

					)

				end


			elseif highestEnabled then

				local prompt,
					money =
					getHighestSteal()


				if prompt then

					performHold(

						prompt,

						"HIGHEST MONEY",

						money

					)

				end

			end

		end


		task.wait(
			STEAL_SCAN_RATE
		)

	end

end)


