local function findOwnerBase()

	local target =
		OWNER_NAME:lower()

	for _, gui in ipairs(
		workspace:GetDescendants()
	) do

		if
			gui:IsA(
				"BillboardGui"
			)
			or gui:IsA(
				"SurfaceGui"
			)
		then

			for _, label in ipairs(
				gui:GetDescendants()
			) do

				if
					(
						label:IsA(
							"TextLabel"
						)
						or label:IsA(
							"TextButton"
						)
					)
					and tostring(
						label.Text
						or ""
					):
						lower():
						find(
							target,
							1,
							true
						)
				then

