local RootAttachment = nil


local function getRoot()

	local character =
		LP.Character

	if not character then
		return nil
	end

	return
		character:FindFirstChild(
			"HumanoidRootPart"
		)

end


local function getRootAttachment()

	local root =
		getRoot()

	if not root then
		return nil
	end


	if
		RootAttachment
		and RootAttachment.Parent == root
	then

		return RootAttachment

	end


	RootAttachment =
		root:FindFirstChild(
			"FTX_ROOT"
		)


	if not RootAttachment then

		RootAttachment =
			Instance.new(
				"Attachment"
			)

		RootAttachment.Name =
			"FTX_ROOT"

		RootAttachment.Parent =
			root

	end


	return RootAttachment

end


--========================================================
-- MONEY
--========================================================

local function parseMoney(text)

	if typeof(text) ~= "string" then
		return nil
	end


	local clean =
		text:
			upper():
			gsub(",", ""):
			gsub("^%s+", ""):
			gsub("%s+$", "")


	local number,
		suffix =
		clean:match(
			"^%$([%d%.]+)([KMBTQ]?)%s*/%s*S$"
		)


	if not number then

		number,
			suffix =
			clean:match(
				"^%$([%d%.]+)([KMBTQ]?)%s*/%s*SEC$"
			)

	end


	if not number then

		number,
			suffix =
			clean:match(
				"^%$([%d%.]+)([KMBTQ]?)%s*PER%s*SEC$"
			)

	end


	number = tonumber(number)

	if not number then
		return nil
	end


	local mult = 1

	if suffix == "K" then
		mult = 1e3

	elseif suffix == "M" then
		mult = 1e6

	elseif suffix == "B" then
		mult = 1e9

	elseif suffix == "T" then
		mult = 1e12

	elseif suffix == "Q" then
		mult = 1e15
	end


	return number * mult

end


local function formatMoney(value)

	if not value then
		return "$0/s"
	end


	if value >= 1e15 then

		return string.format(
			"$%.2fQ/s",
			value / 1e15
		)

	elseif value >= 1e12 then

		return string.format(
			"$%.2fT/s",
			value / 1e12
		)

	elseif value >= 1e9 then

		return string.format(
			"$%.2fB/s",
			value / 1e9
		)

	elseif value >= 1e6 then

		return string.format(
			"$%.2fM/s",
			value / 1e6
		)

	else

		return
			"$"
			.. tostring(
				math.floor(
					value
				)
			)
			.. "/s"

	end

end


--========================================================
-- WORLD PART
--========================================================

local function getWorldPart(object)

	local current = object

	for _ = 1, 20 do

		if not current then
			break
		end


		if
			current:IsA(
				"BillboardGui"
			)

			or current:IsA(
				"SurfaceGui"
			)
		then

			local adornee =
				current.Adornee

			if adornee then

				if adornee:IsA(
					"BasePart"
				) then

					return adornee

				end


				if
					adornee:IsA(
						"Attachment"
					)

					and adornee.Parent

					and adornee.Parent:IsA(
						"BasePart"
					)
				then

					return adornee.Parent

				end

			end

		end


		if current:IsA(
			"BasePart"
		) then

			return current

		end


		if current:IsA(
			"Model"
		) then

			if current.PrimaryPart then
				return current.PrimaryPart
			end

			local p =
				current:
					FindFirstChildWhichIsA(
						"BasePart",
						true
					)

			if p then
				return p
			end

		end


		current =
			current.Parent

	end


	return nil

end


