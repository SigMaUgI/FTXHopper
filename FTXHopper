--========================================================
-- AUTO HOP
--========================================================

task.spawn(function()

	while Gui.Parent do

		if autoHopEnabled then

			--========================================
			-- ALWAYS LET SERVER LOAD FOR >= 2 SEC
			--========================================

			local remaining =
				AUTO_HOP_LOAD_WAIT

				- (
					os.clock()
					- SCRIPT_STARTED_AT
				)


			if remaining > 0 then

				task.wait(
					remaining
				)

			end


			-- Run another scan right before deciding.
			scanMoney()


			local found,
				data =
				hasGoodBrainrot()


			if found then

				--====================================
				-- FOUND $20M/s+
				-- STOP AUTO HOP AND SAVE OFF
				--====================================

				autoHopEnabled =
					false


				Saved.AutoHop =
					false


				refreshButtons()


				saveSettings()


				print(
					"[FTX] AUTO HOP STOPPED - FOUND:",
					data
					and data.Text
					or "$20M+/s"
				)


			elseif not hopping then

				--====================================
				-- NOTHING GOOD FOUND
				-- TRY ANOTHER SERVER
				--====================================

				local started =
					serverHop()


				if not started then

					task.wait(
						TELEPORT_RETRY_DELAY
					)

				else

					-- If teleport gets stuck,
					-- serverHop watchdog will set
					-- hopping=false, then this loop
					-- automatically calls it again.

					local waitStarted =
						os.clock()


					while
						Gui.Parent

						and autoHopEnabled

						and hopping

						and os.clock()
							- waitStarted
							< TELEPORT_TIMEOUT
								+ 1
					do

						task.wait(
							0.1
						)

					end


					if
						autoHopEnabled

						and not hopping
					then

						task.wait(
							TELEPORT_RETRY_DELAY
						)

					end

				end

			end

		end


		task.wait(
			AUTO_HOP_RECHECK_RATE
		)

	end

end)


