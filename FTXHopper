local BasePart =
	nil


local BaseAttachment =
	nil


local BaseBeam =
	nil


local function findOwnerBase()

	local owner =
		OWNER_NAME:
			lower()


	for _, gui in ipairs(
		workspace:
			GetDescendants()
	) do

		if
			gui:IsA(
				"BillboardGui"
			)

			or gui:IsA(
				"SurfaceGui"
			)
		then

			for _, object in ipairs(
				gui:
					GetDescendants()
			) do

				if
					(
						object:IsA(
							"TextLabel"
						)

						or object:IsA(
							"TextButton"
						)
					)

					and tostring(
						object.Text
						or ""
					):
						lower():
						find(
							owner,
							1,
							true
						)
				then

					local part =
						getWorldPart(
							gui
						)


					if part then

						return
							part

					end

				end

			end

		end

	end


	return nil

end


local function setupBase(
	part
)

	if
		BasePart == part
		and BaseBeam
	then

		return

	end


	if BaseBeam then
		BaseBeam:
			Destroy()
	end


	if BaseAttachment then
		BaseAttachment:
			Destroy()
	end


	BasePart =
		part


	BaseAttachment =
		Instance.new(
			"Attachment"
		)

	BaseAttachment.Position =
		Vector3.new(
			0,
			4,
			0
		)

	BaseAttachment.Parent =
		part


	BaseBeam =
		Instance.new(
			"Beam"
		)

	BaseBeam.Attachment0 =
		getRootAttachment()

	BaseBeam.Attachment1 =
		BaseAttachment

	BaseBeam.FaceCamera =
		true

	BaseBeam.Width0 =
		0.65

	BaseBeam.Width1 =
		0.65

	BaseBeam.LightEmission =
		0.6


	BaseBeam.Color =
		ColorSequence.new(
			Color3.fromRGB(
				255,
				220,
				20
			)
		)


	BaseBeam.Parent =
		WorldFolder

end


task.spawn(function()

	while Gui.Parent do

		if
			not BasePart
			or not BasePart.Parent
		then

			local part =
				findOwnerBase()


			if part then

				setupBase(
					part
				)

			end

		end


		local attachment =
			getRootAttachment()


		if
			BaseBeam
			and attachment
		then

			BaseBeam.Attachment0 =
				attachment

		end


		task.wait(
			1
		)

	end

end)


