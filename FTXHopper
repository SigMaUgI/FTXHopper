local function getWorldPart(obj)

	local current =
		obj

	for _ = 1, 20 do

		if not current then
			break
		end

		if
			current:IsA(
				"BillboardGui"
			)
			or current:IsA(
				"SurfaceGui"
			)
		then

			local adornee =
				current.Adornee

			if adornee then

				if
					adornee:IsA(
						"BasePart"
					)
				then

					return adornee

				end

				if
					adornee:IsA(
						"Attachment"
					)
					and adornee.Parent
					and adornee.Parent:IsA(
						"BasePart"
					)
				then

					return adornee.Parent

				end

			end

		end

		if
			current:IsA(
				"BasePart"
			)
		then

			return current

		end

		if
			current:IsA(
				"Model"
			)
		then

			return
				current.PrimaryPart
				or current:
					FindFirstChildWhichIsA(
						"BasePart",
						true
					)

		end

		current =
			current.Parent

	end

	return nil

end

