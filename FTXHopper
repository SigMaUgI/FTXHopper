--========================================================
-- SAVE SYSTEM
--========================================================

local canSave =

	typeof(writefile)
	== "function"

	and typeof(readfile)
	== "function"

	and typeof(isfile)
	== "function"


local function mergeSettings(
	target,
	source
)

	if type(source) ~= "table" then
		return
	end


	for key, value in pairs(
		source
	) do

		if
			type(value) == "table"

			and type(target[key])
				== "table"
		then

			mergeSettings(
				target[key],
				value
			)

		else

			target[key] =
				value

		end

	end

end


local function loadSettings()

	if not canSave then
		return
	end


	pcall(function()

		if not isfile(
			SAVE_FILE
		) then

			return

		end


		local raw =
			readfile(
				SAVE_FILE
			)


		local decoded =
			HttpService:
				JSONDecode(
					raw
				)


		mergeSettings(
			Saved,
			decoded
		)

	end)

end


local function saveSettings()

	if not canSave then
		return
	end


	pcall(function()

		writefile(

			SAVE_FILE,

			HttpService:
				JSONEncode(
					Saved
				)

		)

	end)

end


loadSettings()


